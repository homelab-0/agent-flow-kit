#!/usr/bin/env bash
# agent-flow-kit — the one lifecycle entry point (FR-22).
#
# Read-only:  status, adopt --inspect, verify, schema, monitor, and any --plan.
# Mutating:   adopt, update, pm-continue, enroll-auto-update,
#             catalog-sync --apply, and the monitor's own action verbs.
#
# Git fetching, pulling, branch switching, route selection, and every external
# authority remain outside this executable. pm-continue may call the declared
# Orca presentation adapter after it durably records the handoff transition
# (FR-28, FR-34).
#
# Default evaluation is deterministic and offline: no process is executed and
# no socket is opened. `--live` adds bounded, non-mutating readiness probes; it
# never logs in, never creates a worker, never changes a BMAD repository, never
# runs implementation, never creates placement, and never enables a metered
# path.

set -uo pipefail

# Libraries are sourced before local path defaults are resolved and preserve
# any AFK_STATE_DIR already supplied by the caller. Remember whether PM scope
# itself was explicitly declared so a library-time legacy default cannot mask
# the worktree-scoped default resolved below.
_afk_pm_dir_was_declared=false
[[ -v AFK_PM_DIR ]] && _afk_pm_dir_was_declared=true

AFK_SELF="${BASH_SOURCE[0]}"
AFK_BIN_DIR="$(cd -P -- "$(dirname -- "$AFK_SELF")" && pwd -P)"
if [[ -z "$AFK_BIN_DIR" ]]; then
  printf 'agent-flow-kit: internal error: this executable could not resolve its own location\n' >&2
  exit 1
fi
AFK_INSTALL_ROOT="$(cd -P -- "$AFK_BIN_DIR/.." && pwd -P)"
AFK_LIB_DIR="${AFK_LIB_DIR:-$AFK_INSTALL_ROOT/lib}"

# A missing or unreadable library is an internal failure with a stable message
# and the usage exit code — never a partially loaded lifecycle that answers
# questions with whichever functions happened to load.
for _afk_lib in afk-common afk-orca afk-orca-verify afk-source afk-inventory afk-readiness afk-monitor afk-pm-control afk-commands afk-plan afk-mutate afk-usage afk-auto-update afk-catalog-sync afk-paperclip afk-pm-registry afk-paperclip-report afk-paperclip-plan afk-paperclip-start afk-paperclip-project afk-accept afk-paperclip-evidence afk-roster afk-paperclip-hire afk-harnesses afk-tooling afk-smart-router afk-factory; do
  if [[ ! -r "$AFK_LIB_DIR/$_afk_lib.sh" ]]; then
    printf 'agent-flow-kit: internal error: required library %s.sh is missing or unreadable under %s\n' \
      "$_afk_lib" "$AFK_LIB_DIR" >&2
    exit 1
  fi
done
unset _afk_lib

# shellcheck source=lib/afk-common.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-common.sh"
. "$AFK_LIB_DIR/afk-orca-verify.sh"
# shellcheck source=lib/afk-source.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-source.sh"
# shellcheck source=lib/afk-inventory.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-inventory.sh"
# shellcheck source=lib/afk-readiness.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-readiness.sh"
# shellcheck source=lib/afk-monitor.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-monitor.sh"
# shellcheck source=lib/afk-pm-control.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-pm-control.sh"
# shellcheck source=lib/afk-commands.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-commands.sh"
# shellcheck source=lib/afk-plan.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-plan.sh"
# shellcheck source=lib/afk-mutate.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-mutate.sh"
# shellcheck source=lib/afk-usage.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-usage.sh"
# shellcheck source=lib/afk-auto-update.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-auto-update.sh"
# shellcheck source=lib/afk-catalog-sync.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-catalog-sync.sh"
# shellcheck source=lib/afk-paperclip.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-paperclip.sh"
# shellcheck source=lib/afk-pm-registry.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-pm-registry.sh"
# shellcheck source=lib/afk-paperclip-report.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-paperclip-report.sh"
# shellcheck source=lib/afk-paperclip-plan.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-paperclip-plan.sh"
# shellcheck source=lib/afk-paperclip-start.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-paperclip-start.sh"
# shellcheck source=lib/afk-paperclip-project.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-paperclip-project.sh"
# shellcheck source=lib/afk-accept.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-accept.sh"
# shellcheck source=lib/afk-paperclip-evidence.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-paperclip-evidence.sh"
# shellcheck source=lib/afk-roster.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-roster.sh"
# shellcheck source=lib/afk-paperclip-hire.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-paperclip-hire.sh"
# shellcheck source=lib/afk-harnesses.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-harnesses.sh"
# shellcheck source=lib/afk-tooling.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-tooling.sh"
# shellcheck source=lib/afk-smart-router.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-smart-router.sh"
# shellcheck source=lib/afk-factory.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-factory.sh"
# shellcheck source=lib/afk-cli.sh
# shellcheck disable=SC1090,SC1091
. "$AFK_LIB_DIR/afk-cli.sh"

if ! declare -F afk_cmd_status >/dev/null 2>&1 \
   || ! declare -F afk_render_human >/dev/null 2>&1 \
   || ! declare -F afk_transaction_execute >/dev/null 2>&1 \
   || ! declare -F afk_readiness_evaluate >/dev/null 2>&1 \
   || ! declare -F afk_monitor_reconcile >/dev/null 2>&1 \
   || ! declare -F afk_cmd_pm_checkpoint >/dev/null 2>&1 \
   || ! declare -F afk_plan_compute >/dev/null 2>&1 \
   || ! declare -F afk_usage_report >/dev/null 2>&1 \
   || ! declare -F afk_cmd_enroll_auto_update >/dev/null 2>&1 \
   || ! declare -F afk_cmd_catalog_sync >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_poll >/dev/null 2>&1 \
   || ! declare -F afk_pm_registry_lookup >/dev/null 2>&1 \
   || ! declare -F afk_cmd_pm_registry_reap >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_take >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_settle >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_report >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_plan >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_approval >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_timer >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_project >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_config >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_merge_policy >/dev/null 2>&1 \
   || ! declare -F afk_cmd_route_accept >/dev/null 2>&1 \
   || ! declare -F afk_cmd_paperclip_evidence >/dev/null 2>&1 \
   || ! declare -F afk_cmd_factory >/dev/null 2>&1; then
  printf 'agent-flow-kit: internal error: the lifecycle libraries under %s did not load completely\n' \
    "$AFK_LIB_DIR" >&2
  exit 1
fi

# --- declared local configuration (NFR-8) ----------------------------------
# Every path the lifecycle touches is derived from an overridable declaration,
# so behaviour never depends on the layout of the machine it was written on.
# HOME is a declaration like any other: when it is absent, the derived paths
# stay empty and the command refuses with a stable message instead of reading
# whatever `/.claude` happens to be.

AFK_KIT_ROOT="${AFK_KIT_ROOT:-$AFK_INSTALL_ROOT}"

_afk_state_base="${XDG_STATE_HOME:-}"
if [[ -z "$_afk_state_base" && -n "${HOME:-}" ]]; then
  _afk_state_base="$HOME/.local/state"
fi
AFK_STATE_DIR="${AFK_STATE_DIR:-${_afk_state_base:+$_afk_state_base/agent-flow-kit}}"
unset _afk_state_base
AFK_MANIFEST="${AFK_MANIFEST:-${AFK_STATE_DIR:+$AFK_STATE_DIR/state.json}}"
AFK_JOURNAL="${AFK_JOURNAL:-${AFK_STATE_DIR:+$AFK_STATE_DIR/journal.json}}"
AFK_LOCK_DIR="${AFK_LOCK_DIR:-${AFK_STATE_DIR:+$AFK_STATE_DIR/lock}}"
AFK_BACKUP_ROOT="${AFK_BACKUP_ROOT:-${AFK_STATE_DIR:+$AFK_STATE_DIR/backups}}"
AFK_STAGE_ROOT="${AFK_STAGE_ROOT:-${AFK_STATE_DIR:+$AFK_STATE_DIR/stage}}"
AFK_SKILLS_HOME="${AFK_SKILLS_HOME:-${HOME:+$HOME/.agents/skills}}"
AFK_CLAUDE_HOME="${AFK_CLAUDE_HOME:-${HOME:+$HOME/.claude}}"
AFK_CODEX_HOME="${AFK_CODEX_HOME:-${HOME:+$HOME/.codex}}"

# The orchestration state document is consumed from the declared state
# directory. It is read-only input: nothing here creates or repairs it.
AFK_ORCH_STATE="${AFK_ORCH_STATE:-${AFK_STATE_DIR:+$AFK_STATE_DIR/orchestration.json}}"

# The durable dispatch watch. Re-derived here rather than at source time,
# because the libraries are loaded before AFK_STATE_DIR is resolved and a
# derivation from an empty base would silently produce an unusable path.
AFK_DISPATCH_DIR="${AFK_DISPATCH_DIR:-${AFK_STATE_DIR:+$AFK_STATE_DIR/dispatch}}"
AFK_DISPATCH_WATCH_DIR="${AFK_DISPATCH_WATCH_DIR:-${AFK_DISPATCH_DIR:+$AFK_DISPATCH_DIR/watch}}"
AFK_DISPATCH_INBOX_DIR="${AFK_DISPATCH_INBOX_DIR:-${AFK_DISPATCH_DIR:+$AFK_DISPATCH_DIR/inbox}}"
AFK_DISPATCH_RESULT_DIR="${AFK_DISPATCH_RESULT_DIR:-${AFK_DISPATCH_DIR:+$AFK_DISPATCH_DIR/results}}"
AFK_DISPATCH_MESSAGE_DIR="${AFK_DISPATCH_MESSAGE_DIR:-${AFK_DISPATCH_DIR:+$AFK_DISPATCH_DIR/messages}}"

# The coordinator's own budget subtree: the provided usage observation and the
# PM checkpoint, continuation and reconciliation artifacts. Read-only input and
# kit-owned output, in the declared state directory like everything else.
_afk_scope_helper="$AFK_INSTALL_ROOT/runtime-scope.sh"
[[ -r "$_afk_scope_helper" ]] || _afk_scope_helper="$AFK_INSTALL_ROOT/adapters/runtime-scope.sh"
if [[ -r "$_afk_scope_helper" ]]; then
  # shellcheck disable=SC1090
  . "$_afk_scope_helper"
  _afk_default_pm_dir="$(afk_default_pm_dir 2>/dev/null || true)"
else
  _afk_default_pm_dir=""
fi
if [[ "$_afk_pm_dir_was_declared" != true ]]; then
  AFK_PM_DIR="$_afk_default_pm_dir"
fi
unset _afk_scope_helper _afk_default_pm_dir _afk_pm_dir_was_declared

afk_require_declared_paths() {
  local v
  for v in AFK_KIT_ROOT AFK_STATE_DIR AFK_MANIFEST AFK_JOURNAL AFK_LOCK_DIR \
           AFK_BACKUP_ROOT AFK_STAGE_ROOT \
           AFK_SKILLS_HOME AFK_CLAUDE_HOME AFK_CODEX_HOME AFK_DISPATCH_DIR \
           AFK_PM_DIR; do
    if [[ -z "${!v}" ]]; then
      afk_warn "HOME is not set and $v was not supplied: every managed destination must be declared before any installed state can be read. Nothing was inspected."
      return 1
    fi
  done
  return 0
}

# The bounding tool, declared where the scope that needs it is known. It is
# load-bearing for every observation a live run makes outside this host — the
# Orca listing, the durable close, and the three remote-branch git calls — so an
# operator learns it is missing from the command rather than from a warning
# buried in a result document.
#
# Declared, not required: this kit already has a defined answer for a host that
# cannot bound an observation, and refusing the run would take that answer away
# rather than give it. The live probes report PROBE_BOUND_UNAVAILABLE, and the
# settlement pass refuses the call and retains the resource on NEEDS_OWNER.
# Nothing offline needs the tool at all, so nothing offline is refused for it.
afk_declare_bounding_tool() {
  [[ "$AFK_LIVE_MODE" == "true" ]] || return 0
  afk_have timeout && return 0
  afk_warn "no timeout tool on this host: an external observation cannot be bounded, so the settlement pass refuses its Orca and remote-branch calls and retains what it could not decide, and every live probe reports PROBE_BOUND_UNAVAILABLE."
  return 0
}

afk_usage() {
  cat <<'USAGE'
agent-flow-kit — lifecycle entry point

  agent-flow-kit status [options]
      Read-only installed state: revisions, components, ownership, drift,
      adaptations, registered targets and their wiring, the orchestration
      summary, the dispatch-monitor summary, readiness scopes and the next
      safe action. Mutates nothing. Without --live it probes nothing external.
      Options: --json --live --synthetic-route --stamp <path> --target <id>
               --require-source-eligible
               --allow-noncanonical-source --allow-rollback

  agent-flow-kit adopt --inspect [options]
      Inspect-only adoption analysis. Reports AUTO_ADOPTABLE,
      APPROVAL_REQUIRED or REFUSED and changes nothing.
      Options: --json --allow-noncanonical-source --allow-rollback

  agent-flow-kit adopt [options]
      The adoption transaction: computes a complete plan, establishes durable
      ownership at the identities already installed, verifies the result
      offline, and only then commits the applied-state manifest. Content is
      never overwritten by adopting it.
      Options: --json --plan --approve-plan <identity>
               --allow-noncanonical-source --allow-rollback

  agent-flow-kit update [options]
      Deterministic convergence for an adopted host: plan, backup, journal,
      write, verify, commit — or refuse. Unexplained drift blocks replacement,
      declared local ownership is preserved, and no Git state is selected.
      Options: --json --plan --approve-plan <identity>
               --allow-noncanonical-source --allow-rollback

  agent-flow-kit verify [options]
      Offline verification of the installed state against the applied-state
      manifest. Observes and proves; never repairs, never activates
      orchestration. Without --live it probes no live service.
      Options: --json --live --synthetic-route --stamp <path> --target <id>

  agent-flow-kit orca-verify --contract [--json]
      Check the checked-in Orca command and flag contract against one bounded
      agent-context registry read. Exit 0 pass, 2 missing item, 3 reappeared
      known defect, 4 invalid contract or registry, 5 Orca unavailable.

  agent-flow-kit monitor [options]
      The durable worker-completion watch. Without an action verb it reports
      the watch read-only and writes nothing. One bounded pass per invocation:
      it never blocks, never polls in a loop, and never waits for a worker.
      Options: --json --register <path> --reconcile --cleanup --live

  agent-flow-kit pm-checkpoint --write <path> [options]
      Validate and write the coordinator's own checkpoint artifact, or with
      --continuation the hand-over artifact that makes a successor session a
      loud owner action. Secret-free by rule and atomic; pm-checkpoint itself
      never starts a session.
      Options: --json --write <path> --continuation

  agent-flow-kit pm-start --harness claude|codex|opencode [--json]
      Authorize the next exact harness event in this Orca terminal and resolved
      worktree to register the initial PM session. It never starts a harness.

  agent-flow-kit pm-continue [--ack <path>] [--json]
      Advance the durable PM handoff state machine. It checkpoints before one
      successor launch, requires that successor's acknowledgement, reconciles
      ownership, and only then durably closes the proven old terminal.

  agent-flow-kit usage-report [options]
      OBSERVABILITY ONLY, same posture as usage-check.sh: what the pools spent
      over a rolling window, by harness, model, session class and story, from
      local transcripts (Claude, Codex, opencode). Read-only; a missing source
      reports unknown rather than failing. Emits no routing guidance and is
      not a routing input.
      Options: --json --days <n>

  agent-flow-kit enroll-auto-update --key-ref <op://...> [--key-file <path>]
      Enroll this host once: read the release deploy key from the host's own
      1Password reference, refuse unless its fingerprint is the one the kit
      policy pins, install it (0600, outside every managed tree), record the
      reference, and install the scheduler: a systemd user timer that applies
      releases on Linux, a check-only launchd agent on macOS. Idempotent.
      --check records whether an update is available (what the macOS agent
      runs; it never applies). --remove removes the scheduler and config.
      --check and --remove are exclusive and take no --key-ref/--key-file;
      they use the key path enrollment recorded.

  agent-flow-kit catalog-sync [--check|--apply] [--json]
      Follow the catalog the deployed agent-router trusts, as the public
      prox-ops client manifest names it: resolve main to one commit, fetch the
      manifest and catalog from that commit, and require the v1 schema and a
      matching sha256. --check (the default) reports and writes nothing;
      --apply installs the verified catalog read-only under
      ~/.config/agent-flow-kit/trusted-catalogs and re-points current.yaml.
      Any failure keeps the last verified catalog. No credential is sent.
  agent-flow-kit paperclip-poll [--json]
      One bounded, deterministic claim-side pass over every configured
      Paperclip agent's inbox: adopts newly in-progress issues, re-blocks
      known ones, promotes queued issues, detects stranding and drain, and
      writes local notices. It is the only thing on this host that writes to
      Paperclip. Never loops, sleeps or waits. See docs/PAPERCLIP.md.

  agent-flow-kit pm-registry-reap --scope <key> [--json]
      Re-check one PM scope's own staleness, refuse with PM_OWNER_LIVE or
      PM_OWNER_UNKNOWN unless it is provably stale, then move its ownership.json to pm/reaped/ and
      return its claimed Paperclip notices to their project slug. Never touches a
      live scope or one with a handoff in progress, and never reaps on an
      Orca outage. Calls no LLM.

  agent-flow-kit paperclip-take --slug <slug> [--json]
      Claim every pending Paperclip notice for one project slug (a row of
      the host's projects[] table), in order, as paths only. Only the
      registry's live owner (or the named handoff successor) for that
      project's repo may call it. The old --project flag is refused with
      PAPERCLIP_FLAG_RENAMED.

  agent-flow-kit paperclip-settle --notice <id> [--json]
      Move one claimed notice to notices/settled/. Idempotent; refuses an
      unknown or foreign notice with PAPERCLIP_NOTICE_UNKNOWN.

  agent-flow-kit paperclip-report --issue <id> [--comment-file <path>]
      [--question <qid>] [--final in_review --dir <worktree> --commit <sha>]
      [--status <text> [--story k/n]] [--json]
      The PM's only way to write to Paperclip: publishes one spool entry
      (comment, question or final) or the declared status, never both in one
      call. Only the registry's live owner (or handoff successor) for the
      issue's project may call it. The body is always read from
      --comment-file, never an argument; a seq comes from a locked per-issue
      counter and is published by a no-clobber rename. A final asks for
      Josh's review only: it needs the handoff worktree and commit, a drained
      spool (PAPERCLIP_SPOOL_NOT_DRAINED) and a ready paperclip-readiness
      answer for them (FINAL_NOT_READY). Refuses after a final entry with
      PAPERCLIP_SPOOL_CLOSED.

  agent-flow-kit paperclip-plan --issue <id> --plan-file <path> [--json]
      Validate a plan (every gate must be a line of .afk/gates-allowlist on
      the plan's base branch), publish it as the open plan question, record
      its digest, and revoke any earlier approval for the issue. Owner only.

  agent-flow-kit paperclip-approval --issue <id> [--json]
      Read-only: approved only when Josh's approval digest equals the current
      plan digest and the interim attestation still holds.

  agent-flow-kit paperclip-merge-policy --issue <id> [--json]
      Read-only: pm or human for the project the issue is pinned to, from
      this host's projects[].merge (human when absent, always human for
      agent-flow-kit). Run it before merging any paperclip: PR.

  agent-flow-kit route-accept --story <story.md> --kind human|override|pm-auto
      --actor <name> [--reason <text>] [--json]
  agent-flow-kit route-accept --story <story.md> --verify [--json]
      Write <story>.acceptance.json binding the stamp's decision digest to who
      accepted it. pm-auto only for a natural, free, non-excluded Paperclip
      story in Josh's approved plan with unchanged gates; a Paperclip story
      accepts pm-auto only (human/override: ACCEPTANCE_KIND_NOT_ALLOWED). --verify is the
      check dispatch.sh runs on every cycle of a Paperclip story. On ok, both
      also report the acceptance tuple or the attempt a pm-auto write
      allocated.

  agent-flow-kit paperclip-evidence snapshot [--dir <path>] [--json]
  agent-flow-kit paperclip-evidence launch|outcome ... (dispatch.sh only)
  agent-flow-kit paperclip-evidence latest --issue <id> --story-id <HOM-n.Sk> [--json]
      Write-once attempt, launch and outcome evidence for Paperclip stories,
      and the content snapshot it carries. latest reports the newest record
      by (attempt, cycle) as it is; it is not a readiness verdict.

  agent-flow-kit paperclip-readiness --issue <id> --dir <worktree> [--commit <sha>] [--json]
      Read-only: ready only when the approved schema-2 plan's newest build
      and independent review evidence all pass on the worktree's current
      tree. Exit 0 ready, 3 not ready with every reason. Nothing calls it
      automatically and it publishes nothing.

  agent-flow-kit review-verdict --check [--json]
      The gate a schema-2 reviewer story runs. dispatch.sh sets
      AFK_GATE_STORY to the story; the sibling <story>.verdict.json must be
      an APPROVE of the reviewed builder, bound to the current approved plan,
      with no open blocker or major finding. Exit 0 only when it is.

  agent-flow-kit paperclip-project add --project-id <uuid> --slug <s> --repo <abs-path>
      [--harness claude|codex|opencode] [--max-active <n>] [--merge human|pm]
      [--accept-mismatch] [--json]
  agent-flow-kit paperclip-project set --slug <s> [--harness <h>] [--max-active <n>]
      [--merge human|pm] [--json]
  agent-flow-kit paperclip-project remove --slug <s> [--json]
  agent-flow-kit paperclip-project list [--json]
      Onboard a Paperclip Project on this host: edits the host's projects[]
      table (atomic write, mode 600). `add` reads GET /api/projects/<id> with
      the host key and refuses a missing or archived project and a repoUrl
      that differs from the repo's origin (--accept-mismatch overrides, but
      the poller still self-blocks). `remove` refuses while an issue pinned
      to the slug is not closed. Never writes to Paperclip.

  agent-flow-kit paperclip-config --migrate --project-id <uuid> [--slug <s>] [--json]
      One-shot v1 to v2 config migration (exactly one v1 agent; refuses while
      any issue is not closed or a notice is claimed). Keeps the old file as
      paperclip.json.v1.<timestamp>.

  agent-flow-kit paperclip-timer --install|--remove|--status [--json]
      Linux only: a systemd user service and timer running paperclip-poll
      every 90s (RandomizedDelaySec=15s, Persistent=false). The unit holds no
      secret and no key reference. --status also reports
      PAPERCLIP_POLLER_STALE when the last successful pass is older than 3
      intervals, and reaps a provably stale poll lock (AC-7b) before
      answering. macOS refuses with PAPERCLIP_TIMER_UNSUPPORTED_PLATFORM.

  agent-flow-kit agent [options] [prompt...]      (also: afk)
      Standalone route: start the best agent CLI installed here (claude,
      codex, opencode, grok, agy) for the task, chosen by benchmark score,
      usage left in each subscription and cost. -p prints one answer, with
      failover; --explain shows the choice. See `afk --help`.

  agent-flow-kit factory <subcommand> [options]
      Autonomous multi-harness Software Factory orchestrator & Paperclip native
      execution plane:
        init | roster | run | poll | alive | sync-reviews | resume | watchdog | status
        pools | harnesses | update-harnesses | models | route-preview | sync-benchmarks
        tooling [--sync-paperclip-skills] | tooling-sync | tooling-publish-paperclip | tooling-register-mcp | tooling-register-skill
        evaluate-merge | context-check | retire

  agent-flow-kit schema
      The documented machine contract: schema version, state, reason and
      ownership vocabularies, plan and operation vocabularies, and exit
      semantics. Takes no options.

Options are validated against the command: an option that means nothing to the
command you ran is a usage failure, not a silently ignored word.

  --json                        Machine-readable result on stdout.
  --live                        On status and verify: add bounded, non-mutating
                                readiness probes for Orca, the stamp validator
                                and its offline fixtures, native harness
                                capability and auth CLASS, and the central
                                router. On monitor: authorize the bounded
                                read-only Orca terminal observation the
                                settlement pass needs — it does not turn on the
                                readiness probes, which are a status question.
                                Never logs in, never creates a worker, never
                                spends provider tokens, never enables a metered
                                path.
  --synthetic-route             With --live only: additionally ask the router
                                for one harmless recommendation. Nothing is
                                stamped, nothing is launched.
  --stamp <path>                Evaluate ROUTE_READY for one accepted
                                execution stamp. The observation is diagnostic
                                evidence and never launch authorization.
  --target <id>                 With --stamp only: bind route readiness to one
                                registered BMAD target.
  --register <path>             monitor only: establish the durable watch for
                                one supervised Dispatch from a descriptor,
                                before control is yielded. Idempotent.
  --reconcile                   monitor only: consume every pending completion
                                delivery, retain and reconcile it, and only
                                then acknowledge it. A replay is dropped.
  --cleanup                     monitor only: reconcile, then release the
                                terminal, worktree and branch a settled worker
                                owned. Requires --live, fails closed on any
                                ambiguity, and never touches a resource this
                                host cannot prove it created for that Dispatch.
  --pm-stamp <path>             status and monitor only: the coordinator window
                                is this stamp profile's catalog min_context. One
                                that cannot be resolved reports
                                PM_STAMP_UNUSABLE, never falling through.
  --harness <name>              pm-start only: the PM harness whose next exact
                                event may claim the fresh registration intent.
  --write <path>                pm-checkpoint only: the submitted artifact.
  --continuation                pm-checkpoint only: write the hand-over
                                artifact rather than the checkpoint.
  --plan                        Compute and print the complete plan; write
                                nothing. The plan carries a stable identity.
  --days <n>                    usage-report only: the rolling window in
                                days. Default 7.
  --approve-plan <identity>     Authorize exactly the plan with that identity.
                                An approval never transfers to a plan that any
                                authority-relevant input has changed.
  --require-source-eligible     Make mutation-source eligibility part of the
                                requested scope, so an ineligible checkout
                                exits 4 instead of merely reporting.
  --allow-noncanonical-source   Record explicit intent to use a detached,
                                non-default or divergent revision.
  --allow-rollback              Record explicit intent to treat an older
                                source revision as a rollback.

Exit codes
  0 requested scope succeeded      1 command, internal or usage failure
  2 owner action or conflict       3 deterministic not-ready
  4 source or precondition refusal 5 live dependency unavailable

Environment (declared local configuration)
  AFK_KIT_ROOT AFK_STATE_DIR AFK_MANIFEST AFK_JOURNAL AFK_LOCK_DIR
  AFK_BACKUP_ROOT AFK_STAGE_ROOT
  AFK_SKILLS_HOME AFK_CLAUDE_HOME AFK_CODEX_HOME AFK_LIB_DIR
  AFK_ORCA_BIN AFK_CLAUDE_BIN AFK_CODEX_BIN AFK_VALIDATOR_BIN AFK_CURL_BIN
  AFK_ORCH_STATE AFK_CLAUDE_TRUST_DB AFK_ROUTER_TOKEN_ENV
  AFK_LIVE_TIMEOUT_MS AFK_LIVE_FRESHNESS_S
  AFK_DISPATCH_DIR AFK_DISPATCH_WATCH_DIR AFK_DISPATCH_INBOX_DIR
  AFK_DISPATCH_RESULT_DIR AFK_MONITOR_POLL_SECONDS AFK_PM_DIR AFK_ROUTER_CATALOG
  AFK_MONITOR_BACKOFF_CEILING_SECONDS AFK_MONITOR_HEARTBEAT_SECONDS
  AFK_MONITOR_PROTECTED_BRANCHES
  AFK_PM_SUCCESSOR_LAUNCHER AFK_PM_TERMINAL_CLOSER AFK_PM_ACK_FILE
  AFK_PM_SESSION_ADAPTER
USAGE
}

# Which options each command actually understands. There is no shared pool:
# `status --inspect` and `schema --json` are mistakes, and a lifecycle that
# accepts a word it will not act on teaches the caller a false contract.
afk_option_allowed() { # <command> <option>
  case "$1" in
    status)
      case "$2" in
        --json|--require-source-eligible|--allow-noncanonical-source|--allow-rollback|--live|--synthetic-route|--stamp|--target|--pm-stamp)
          return 0 ;;
      esac ;;
    adopt)
      case "$2" in
        --json|--inspect|--plan|--approve-plan|--allow-noncanonical-source|--allow-rollback)
          return 0 ;;
      esac ;;
    update)
      case "$2" in
        --json|--plan|--approve-plan|--allow-noncanonical-source|--allow-rollback)
          return 0 ;;
      esac ;;
    verify)
      case "$2" in
        --json|--live|--synthetic-route|--stamp|--target) return 0 ;;
      esac ;;
    monitor)
      case "$2" in
        --json|--live|--register|--reconcile|--cleanup|--pm-stamp) return 0 ;;
      esac ;;
    pm-start)
      case "$2" in --json|--harness) return 0 ;; esac ;;
    pm-checkpoint)
      case "$2" in
        --json|--write|--continuation) return 0 ;;
      esac ;;
    pm-continue)
      case "$2" in --json|--ack) return 0 ;; esac ;;
    usage-report)
      case "$2" in --json|--days) return 0 ;; esac ;;
    enroll-auto-update)
      case "$2" in --key-ref|--key-file|--check|--remove) return 0 ;; esac ;;
    catalog-sync)
      case "$2" in --json|--check|--apply) return 0 ;; esac ;;
    paperclip-poll)
      case "$2" in --json) return 0 ;; esac ;;
    pm-registry-reap)
      case "$2" in --json|--scope) return 0 ;; esac ;;
    paperclip-take)
      case "$2" in --json|--slug) return 0 ;; esac ;;
    paperclip-settle)
      case "$2" in --json|--notice) return 0 ;; esac ;;
    paperclip-report)
      case "$2" in
        --json|--issue|--comment-file|--question|--final|--dir|--commit|--status|--story) return 0 ;;
      esac ;;
    paperclip-plan)
      case "$2" in --json|--issue|--plan-file) return 0 ;; esac ;;
    paperclip-approval|paperclip-merge-policy)
      case "$2" in --json|--issue) return 0 ;; esac ;;
    paperclip-timer)
      case "$2" in --json|--install|--remove|--status) return 0 ;; esac ;;
    paperclip-project)
      case "$2" in --json|--slug|--project-id|--repo|--harness|--max-active|--merge|--accept-mismatch) return 0 ;; esac ;;
    paperclip-config)
      case "$2" in --json|--migrate|--project-id|--slug) return 0 ;; esac ;;
    route-accept)
      case "$2" in --json|--story|--kind|--actor|--reason|--verify) return 0 ;; esac ;;
  esac
  return 1
}

afk_main() {
  local cmd json_mode="false" require_source="false"
  local allow_noncanonical="false" allow_rollback="false"
  local inspect="false" plan_only="false" approval=""
  local monitor_verbs=0
  local pm_write="" pm_continuation="false" pm_harness=""
  local pmr_scope="" pc_slug="" pc_notice="" pct_action=""
  local pc_issue="" pc_plan_file="" pc_comment_file="" pc_question="" pc_final="" pc_status_text="" pc_story=""
  local pc_dir="" pc_commit=""
  local usage_days=""
  local au_mode="enroll" au_key_ref="" au_key_file="" au_prev=""
  local cs_apply="false"
  local ra_kind="" ra_actor="" ra_reason="" ra_verify="false"
  local pj_verb="" pj_id="" pj_repo="" pj_max="" pj_merge="" pj_accept="false" pj_migrate="false"

  cmd="${1:-help}"
  if (( $# > 0 )); then shift; fi

  if [[ "$cmd" == orca-verify ]]; then
    local contract_json=false
    if (( $# == 1 )) && [[ "$1" == --contract ]]; then :
    elif (( $# == 2 )) && [[ "$1" == --contract && "$2" == --json ]]; then contract_json=true
    else
      afk_warn "orca-verify requires --contract and accepts only optional --json"
      return "$AFK_EXIT_USAGE"
    fi
    afk_require_tools || return "$AFK_EXIT_USAGE"
    afk_orca_contract_check
    local verify_rc=$?
    if [[ "$contract_json" == true ]]; then
      printf '%s\n' "$AFK_ORCA_VERIFY_JSON"
    elif (( verify_rc == 0 )); then
      printf 'Orca contract check passed.\n'
    else
      printf 'Orca contract check failed: %s.\n' "$AFK_ORCA_VERIFY_CLASS" >&2
    fi
    return "$verify_rc"
  fi

  case "$cmd" in
    help|-h|--help)
      afk_usage
      return "$AFK_EXIT_OK" ;;
  esac

  # paperclip-evidence has verbs with their own closed option vocabulary.
  if [[ "$cmd" == paperclip-evidence ]]; then
    afk_require_tools || return "$AFK_EXIT_USAGE"
    afk_require_declared_paths || return "$AFK_EXIT_USAGE"
    afk_cmd_paperclip_evidence "$@"
    return $?
  fi

  # agent: the standalone route. Its options are its own (see afk --help).
  if [[ "$cmd" == agent ]]; then
    afk_require_tools || return "$AFK_EXIT_USAGE"
    afk_cli_main "$@"
    return $?
  fi

  # factory has subcommands (roster, init, run, status, context-check, evaluate-merge, retire).
  if [[ "$cmd" == factory ]]; then
    afk_require_tools || return "$AFK_EXIT_USAGE"
    afk_require_declared_paths || return "$AFK_EXIT_USAGE"
    afk_cmd_factory "$@"
    return $?
  fi

  # paperclip-readiness is read-only, with its own closed option vocabulary.
  if [[ "$cmd" == paperclip-readiness ]]; then
    afk_require_tools || return "$AFK_EXIT_USAGE"
    afk_require_declared_paths || return "$AFK_EXIT_USAGE"
    afk_cmd_paperclip_readiness "$@"
    return $?
  fi

  # review-verdict --check is a gate: its one input is AFK_GATE_STORY.
  if [[ "$cmd" == review-verdict ]]; then
    local rv_json=false rv_check=false rv_a
    for rv_a in "$@"; do
      case "$rv_a" in
        --check) rv_check=true ;;
        --json) rv_json=true ;;
        *) rv_check=bad; break ;;
      esac
    done
    if [[ "$rv_check" != true ]]; then
      afk_warn "review-verdict requires --check and accepts only optional --json"
      return "$AFK_EXIT_USAGE"
    fi
    afk_require_tools || return "$AFK_EXIT_USAGE"
    afk_require_declared_paths || return "$AFK_EXIT_USAGE"
    afk_cmd_review_verdict "$rv_json"
    return $?
  fi

  while (( $# > 0 )); do
    case "$1" in
      -h|--help)
        afk_usage
        return "$AFK_EXIT_OK" ;;
      *)
        # AD-23: --project became --slug; the old flag is refused, never aliased.
        if [[ "$cmd" == paperclip-take && "$1" == --project ]]; then
          afk_warn "PAPERCLIP_FLAG_RENAMED: paperclip-take takes --slug <slug> now, not --project"
          return "$AFK_EXIT_USAGE"
        fi
        if [[ "$cmd" == paperclip-project && -z "$pj_verb" && "$1" =~ ^(add|set|remove|list)$ ]]; then
          pj_verb="$1"; shift; continue
        fi
        if ! afk_option_allowed "$cmd" "$1"; then
          afk_warn "'$(afk_safe_diagnostic "$cmd")' does not accept the argument '$(afk_safe_diagnostic "$1")'"
          afk_usage >&2
          return "$AFK_EXIT_USAGE"
        fi
        case "$1" in
          --json)                      json_mode="true" ;;
          --require-source-eligible)   require_source="true" ;;
          --allow-noncanonical-source) allow_noncanonical="true" ;;
          --allow-rollback)            allow_rollback="true" ;;
          --inspect)                   inspect="true" ;;
          --plan)                      plan_only="true" ;;
          --live)                      AFK_LIVE_MODE="true" ;;
          --synthetic-route)           AFK_SYNTHETIC_ROUTE="true" ;;
          --reconcile)
            AFK_MONITOR_MODE="reconcile"; monitor_verbs=$((monitor_verbs + 1)) ;;
          --cleanup)
            AFK_MONITOR_MODE="cleanup"; monitor_verbs=$((monitor_verbs + 1)) ;;
          --register)
            # The value is a path. Like every other option value it is never
            # echoed back in a diagnostic: only the closed option vocabulary is.
            if (( $# < 2 )); then
              afk_warn "--register requires the path of the dispatch descriptor to watch"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            AFK_MONITOR_DESCRIPTOR="$2"
            AFK_MONITOR_MODE="register"
            monitor_verbs=$((monitor_verbs + 1))
            shift ;;
          --stamp)
            # The value is a path. Like every other option value it is never
            # echoed back in a diagnostic: only the closed option vocabulary is.
            if (( $# < 2 )); then
              afk_warn "--stamp requires the path of the execution stamp to evaluate"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            AFK_STAMP_FILE="$2"
            shift ;;
          --continuation)              pm_continuation="true" ;;
          --check|--remove)
            if [[ "$cmd" == paperclip-timer ]]; then
              if [[ -n "$pct_action" && "$pct_action" != remove ]]; then
                afk_warn "paperclip-timer: pass exactly one of --install, --remove or --status"
                return "$AFK_EXIT_USAGE"
              fi
              pct_action="remove"
            else
              if [[ "$au_mode" != enroll && "$au_mode" != "${1#--}" ]]; then
                afk_warn "enroll-auto-update: --check and --remove cannot be combined"
                return "$AFK_EXIT_USAGE"
              fi
              au_mode="${1#--}"
            fi ;;
          --apply)                     cs_apply="true" ;;
          --install)
            if [[ -n "$pct_action" && "$pct_action" != install ]]; then
              afk_warn "paperclip-timer: pass exactly one of --install, --remove or --status"
              return "$AFK_EXIT_USAGE"
            fi
            pct_action="install" ;;
          --status)
            # `--status` is shared vocabulary: paperclip-timer's bare action
            # flag and paperclip-report's `<text>`-taking status write. The
            # two commands are mutually exclusive, so dispatch on $cmd rather
            # than letting one case pattern shadow the other.
            if [[ "$cmd" == paperclip-timer ]]; then
              if [[ -n "$pct_action" && "$pct_action" != status ]]; then
                afk_warn "paperclip-timer: pass exactly one of --install, --remove or --status"
                return "$AFK_EXIT_USAGE"
              fi
              pct_action="status"
            else
              # The value is status text — never echoed back; only the
              # closed option vocabulary is.
              if (( $# < 2 )) || { [[ "$2" == --* ]] && afk_option_allowed "$cmd" "$2"; }; then
                afk_warn "$1 requires its declared value"
                afk_usage >&2
                return "$AFK_EXIT_USAGE"
              fi
              pc_status_text="$2"
              shift
            fi ;;
          --key-ref|--key-file)
            # A reference or a path, never a key; still not echoed back.
            if (( $# < 2 )); then
              afk_warn "$1 requires its declared value"
              return "$AFK_EXIT_USAGE"
            fi
            if [[ "$1" == --key-ref ]]; then au_prev="$au_key_ref"; else au_prev="$au_key_file"; fi
            if [[ -n "$au_prev" && "$au_prev" != "$2" ]]; then
              afk_warn "$1 was given twice with different values"
              return "$AFK_EXIT_USAGE"
            fi
            if [[ "$1" == --key-ref ]]; then au_key_ref="$2"; else au_key_file="$2"; fi
            shift ;;
          --days)
            if (( $# < 2 )); then
              afk_warn "--days requires the rolling window in days"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            usage_days="$2"
            shift ;;
          --ack)
            if (( $# < 2 )); then afk_warn "--ack requires a successor acknowledgement document"; return "$AFK_EXIT_USAGE"; fi
            AFK_PM_ACK_FILE="$2"; shift ;;
          --scope|--slug|--notice)
            # The value is a scope key, project slug or notice id — never
            # echoed back; only the closed option vocabulary is.
            if (( $# < 2 )); then
              afk_warn "$1 requires its declared value"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            case "$1" in
              --scope)   pmr_scope="$2" ;;
              --slug)    pc_slug="$2" ;;
              --notice)  pc_notice="$2" ;;
            esac
            shift ;;
          --verify)                    ra_verify="true" ;;
          --accept-mismatch)           pj_accept="true" ;;
          --migrate)                   pj_migrate="true" ;;
          --project-id|--repo|--max-active|--merge)
            if (( $# < 2 )) || { [[ "$2" == --* ]] && afk_option_allowed "$cmd" "$2"; }; then
              afk_warn "$1 requires its declared value"
              return "$AFK_EXIT_USAGE"
            fi
            case "$1" in
              --project-id) pj_id="$2" ;;
              --repo)       pj_repo="$2" ;;
              --max-active) pj_max="$2" ;;
              --merge)      pj_merge="$2" ;;
            esac
            shift ;;
          --issue|--plan-file|--comment-file|--question|--final|--dir|--commit|--story|--kind|--actor|--reason)
            # The value is an issue id, a file path, a short question id, a
            # final status word, a commit id, or a story fraction — never
            # echoed back; only the closed option vocabulary is.
            if (( $# < 2 )) || { [[ "$2" == --* ]] && afk_option_allowed "$cmd" "$2"; }; then
              afk_warn "$1 requires its declared value"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            case "$1" in
              --issue)        pc_issue="$2" ;;
              --plan-file)    pc_plan_file="$2" ;;
              --comment-file) pc_comment_file="$2" ;;
              --question)     pc_question="$2" ;;
              --final)        pc_final="$2" ;;
              --dir)          pc_dir="$2" ;;
              --commit)       pc_commit="$2" ;;
              --story)        pc_story="$2" ;;
              --kind)         ra_kind="$2" ;;
              --actor)        ra_actor="$2" ;;
              --reason)       ra_reason="$2" ;;
            esac
            shift ;;
          --pm-stamp|--write|--harness)
            # The VALUE is a path or an id and is never echoed back in a
            # diagnostic; the option name is closed vocabulary, so it is.
            if (( $# < 2 )); then
              afk_warn "$1 requires its declared value"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            case "$1" in
              --pm-stamp) AFK_PM_STAMP_FILE="$2" ;;
              --write)    pm_write="$2" ;;
              --harness)  pm_harness="$2" ;;
            esac
            shift ;;
          --target)
            if (( $# < 2 )); then
              afk_warn "--target requires the id of a registered BMAD target"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            AFK_ROUTE_TARGET="$2"
            shift ;;
          --approve-plan)
            # The value is a plan identity. It is never echoed back in a
            # diagnostic: only the closed option vocabulary ever is.
            if (( $# < 2 )); then
              afk_warn "--approve-plan requires the plan identity it authorizes"
              afk_usage >&2
              return "$AFK_EXIT_USAGE"
            fi
            approval="$2"
            shift ;;
        esac ;;
    esac
    shift
  done

  # Mode combinations that would make the command's authority ambiguous.
  if [[ "$inspect" == "true" && "$plan_only" == "true" ]]; then
    afk_warn "adopt --inspect and adopt --plan are different questions: --inspect classifies what is installed, --plan computes the transaction. Ask one at a time."
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$inspect" == "true" && -n "$approval" ]]; then
    afk_warn "adopt --inspect authorizes nothing, so it does not accept an approval."
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$plan_only" == "true" && -n "$approval" ]]; then
    afk_warn "--plan computes a plan and writes nothing, so an approval has nothing to authorize."
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$AFK_SYNTHETIC_ROUTE" == "true" && "$AFK_LIVE_MODE" != "true" ]]; then
    afk_warn "--synthetic-route asks the router for a recommendation, which is a live probe: pass --live to request live evaluation explicitly."
    return "$AFK_EXIT_USAGE"
  fi
  if [[ -n "$AFK_ROUTE_TARGET" && -z "$AFK_STAMP_FILE" ]]; then
    afk_warn "--target binds route readiness to one registered target, so it needs the --stamp whose route it binds."
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == "pm-checkpoint" && -z "$pm_write" ]]; then
    afk_warn "pm-checkpoint validates and writes one submitted artifact, so it needs the --write path that carries it."
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == pm-start && "$pm_harness" != claude && "$pm_harness" != codex && "$pm_harness" != opencode ]]; then
    afk_warn "pm-start requires --harness claude, codex, or opencode"
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == pm-registry-reap && -z "$pmr_scope" ]]; then
    afk_warn "pm-registry-reap needs the --scope key of the PM registration to re-check"
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == paperclip-take && -z "$pc_slug" ]]; then
    afk_warn "paperclip-take needs the --slug of the project to claim notices for"
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == paperclip-settle && -z "$pc_notice" ]]; then
    afk_warn "paperclip-settle needs the --notice id to settle"
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == paperclip-report ]]; then
    if [[ -z "$pc_issue" ]]; then
      afk_warn "paperclip-report needs the --issue id to write to"
      return "$AFK_EXIT_USAGE"
    fi
    if [[ -n "$pc_status_text" && ( -n "$pc_comment_file" || -n "$pc_question" || -n "$pc_final" ) ]]; then
      afk_warn "paperclip-report --status never touches the spool; ask a status write or a spool entry, not both."
      return "$AFK_EXIT_USAGE"
    fi
    if [[ -z "$pc_status_text" && -z "$pc_comment_file" ]]; then
      afk_warn "paperclip-report needs either --status <text> or --comment-file <path>"
      return "$AFK_EXIT_USAGE"
    fi
    if [[ -n "$pc_question" && -n "$pc_final" ]]; then
      afk_warn "paperclip-report --question and --final are different entries; ask one at a time."
      return "$AFK_EXIT_USAGE"
    fi
    if [[ ( -n "$pc_dir" || -n "$pc_commit" ) && -z "$pc_final" ]]; then
      afk_warn "paperclip-report --dir and --commit name a final's handoff; they need --final in_review."
      return "$AFK_EXIT_USAGE"
    fi
  fi
  if [[ ( "$cmd" == paperclip-plan || "$cmd" == paperclip-approval || "$cmd" == paperclip-merge-policy ) && -z "$pc_issue" ]] ||
     [[ "$cmd" == paperclip-plan && -z "$pc_plan_file" ]]; then
    afk_warn "$cmd needs --issue <id>, and paperclip-plan also needs --plan-file <path>"
    return "$AFK_EXIT_USAGE"
  fi
  local ra_bad=false
  if [[ "$cmd" == route-accept ]]; then
    [[ -n "$pc_story" ]] || ra_bad=true
    if [[ "$ra_verify" == true ]]; then
      [[ -z "$ra_kind$ra_actor$ra_reason" ]] || ra_bad=true
    elif [[ ! "$ra_kind" =~ ^(human|override|pm-auto)$ || -z "$ra_actor" ||
            ( "$ra_kind" == override && -z "$ra_reason" ) ]]; then
      ra_bad=true
    fi
  fi
  if [[ "$ra_bad" == true ]]; then
    afk_warn "route-accept needs --story and either --verify alone, or --kind human|override|pm-auto with --actor (and --reason for override)"
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == paperclip-project ]]; then
    local pj_ok=true
    case "$pj_verb" in
      add) [[ -n "$pj_id" && -n "$pc_slug" && -n "$pj_repo" ]] || pj_ok=false ;;
      set|remove) [[ -n "$pc_slug" ]] || pj_ok=false ;;
      list) ;;
      *) pj_ok=false ;;
    esac
    if [[ "$pj_ok" != true ]]; then
      afk_warn "paperclip-project needs a verb: add (--project-id --slug --repo), set/remove (--slug) or list"
      return "$AFK_EXIT_USAGE"
    fi
  fi
  if [[ "$cmd" == paperclip-config && "$pj_migrate" != true ]]; then
    afk_warn "paperclip-config needs --migrate"
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$cmd" == paperclip-timer && -z "$pct_action" ]]; then
    afk_warn "paperclip-timer needs exactly one of --install, --remove or --status"
    return "$AFK_EXIT_USAGE"
  fi
  if (( monitor_verbs > 1 )); then
    afk_warn "monitor performs one bounded pass: register, reconcile and cleanup are separate questions, so ask one at a time."
    return "$AFK_EXIT_USAGE"
  fi
  if [[ "$AFK_MONITOR_MODE" == "cleanup" && "$AFK_LIVE_MODE" != "true" ]]; then
    afk_warn "monitor --cleanup has to ask Orca whether a worker terminal may be closed and prove that it closed, which is a live observation: pass --live to authorize it explicitly."
    return "$AFK_EXIT_USAGE"
  fi

  if ! afk_require_tools; then
    return "$AFK_EXIT_USAGE"
  fi
  afk_declare_bounding_tool

  case "$cmd" in
    status)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_status "$json_mode" "$require_source" "$allow_noncanonical" "$allow_rollback"
      return $? ;;
    adopt)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      if [[ "$inspect" == "true" ]]; then
        afk_cmd_adopt_inspect "$json_mode" "$allow_noncanonical" "$allow_rollback"
        return $?
      fi
      afk_run_mutation adopt "$json_mode" "$plan_only" "$approval" \
        "$allow_noncanonical" "$allow_rollback"
      return $? ;;
    update)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_run_mutation update "$json_mode" "$plan_only" "$approval" \
        "$allow_noncanonical" "$allow_rollback"
      return $? ;;
    verify)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_verify "$json_mode"
      return $? ;;
    monitor)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      # On this command --live authorizes the monitor's own bounded Orca
      # observation and nothing else. The readiness probes answer a different
      # question and are not silently switched on by a settlement pass.
      AFK_MONITOR_LIVE="$AFK_LIVE_MODE"
      AFK_LIVE_MODE="false"
      afk_cmd_monitor "$json_mode"
      return $? ;;
    pm-checkpoint)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_pm_checkpoint "$json_mode" "$pm_write" "$pm_continuation"
      return $? ;;
    pm-start)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_pm_start "$json_mode" "$pm_harness"
      return $? ;;
    pm-continue)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_pm_continue "$json_mode"
      return $? ;;
    usage-report)
      local -a usage_args=()
      [[ "$json_mode" == "true" ]] && usage_args+=(--json)
      [[ -n "$usage_days" ]] && usage_args+=(--days "$usage_days")
      afk_usage_report "${usage_args[@]}"
      return $? ;;
    enroll-auto-update)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_enroll_auto_update "$au_mode" "$au_key_ref" "$au_key_file"
      return $? ;;
    catalog-sync)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      if [[ "$au_mode" == check && "$cs_apply" == "true" ]]; then
        afk_warn "catalog-sync: --check reports and --apply installs; ask one at a time."
        return "$AFK_EXIT_USAGE"
      fi
      if [[ "$cs_apply" == "true" ]]; then
        afk_cmd_catalog_sync apply "$json_mode"
      else
        afk_cmd_catalog_sync check "$json_mode"
      fi
      return $? ;;
    paperclip-poll)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_poll "$json_mode"
      return $? ;;
    pm-registry-reap)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_pm_registry_reap "$json_mode" "$pmr_scope"
      return $? ;;
    paperclip-take)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_take "$json_mode" "$pc_slug"
      return $? ;;
    paperclip-settle)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_settle "$json_mode" "$pc_notice"
      return $? ;;
    paperclip-report)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_report "$json_mode" "$pc_issue" "$pc_comment_file" \
        "$pc_question" "$pc_final" "$pc_status_text" "$pc_story" "$pc_dir" "$pc_commit"
      return $? ;;
    paperclip-plan)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_plan "$json_mode" "$pc_issue" "$pc_plan_file"
      return $? ;;
    paperclip-approval)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_approval "$json_mode" "$pc_issue"
      return $? ;;
    paperclip-merge-policy)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_merge_policy "$json_mode" "$pc_issue"
      return $? ;;
    paperclip-timer)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_timer "$json_mode" "$pct_action"
      return $? ;;
    paperclip-project)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_project "$json_mode" "$pj_verb" "$pj_id" "$pc_slug" "$pj_repo" "$pm_harness" "$pj_max" "$pj_merge" "$pj_accept"
      return $? ;;
    paperclip-config)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_paperclip_config "$json_mode" "$pj_id" "$pc_slug"
      return $? ;;
    route-accept)
      afk_require_declared_paths || return "$AFK_EXIT_USAGE"
      afk_cmd_route_accept "$json_mode" "$pc_story" "$ra_kind" "$ra_actor" "$ra_reason" "$ra_verify"
      return $? ;;
    schema)
      afk_cmd_schema || return "$AFK_EXIT_USAGE"
      return "$AFK_EXIT_OK" ;;
    *)
      afk_warn "unknown command: $(afk_safe_diagnostic "$cmd")"
      afk_usage >&2
      return "$AFK_EXIT_USAGE" ;;
  esac
}

# The operation lock is released even if the shell is interrupted, so an
# interrupted command does not leave an installation looking busy. A signal
# that lands while the lock is being TAKEN is held until the take has
# published its owner record or failed (afk_lock_take), and honoured then, so
# an interrupted acquisition leaves no recordless lock either; only a death no
# handler sees (SIGKILL, an OOM kill, power loss) or a signal that also kills
# the take's `mkdir`, whose outcome it cannot prove, can. The journal is
# deliberately NOT cleaned up here: an interrupted transaction must stay
# visible to the next invocation, which is what makes recovery possible.
#
# Release belongs to EXIT and to nothing else. A handler installed on INT or
# TERM that does not exit RESUMES the script at the point the signal landed, so
# releasing there would hand the lock back while this process is still inside
# its transaction and still writing. A second invocation could then take the
# freed lock and mutate the same installation alongside the first — the exact
# state the lock exists to make impossible (FR-92), reached without the owner
# ever dying. Every prior consideration of interruption was about a process
# that DIED holding the lock; this is the one where it lives on without it.
#
# So the signal handlers terminate instead of returning. Exiting runs the EXIT
# trap, which is what releases the lock — at the one moment this process can no
# longer write. The status is the conventional 128 + signal number, because a
# run killed by a signal produced no result and must not be read as one. The one
# deliberate exception is a take in progress: the handler returns there, and
# the take honours the signal before it returns to anything — it writes nothing
# in an installation, so no transaction resumes. The set and the handler live
# in lib/afk-mutate.sh because the PM session adapter takes the same lock.
#
# Which signals need a handler is not a matter of taste. A terminating signal
# this script does NOT trap is worse than one it does: bash runs the EXIT trap
# and then dies immediately, without waiting for the command it was running.
# The lock therefore comes back at the instant the shell dies while the child
# that was mid-write — a cp staging a managed tree, say — is still alive and
# still writing. That is the same two-owners-one-installation state as above,
# arrived at from the other side. Trapping defers the handler until the running
# command finishes, which is precisely the ordering the invariant needs.
#
# The set (AFK_TRAPPED_SIGNALS) is every signal that terminates this shell by
# default and can be delivered to it alone. HUP is the one naturally reachable —
# `kill -HUP <pid>`, `pkill -HUP`, a supervisor signalling the main pid — and a
# whole-process-group hangup is not the dangerous shape, because there the
# writer dies with the shell. USR1, USR2 and ALRM are not reachable through any
# convention this tool takes part in; they are trapped because they are free
# and because an invariant stated as "no terminating signal frees the lock
# under a live writer" should not have holes an auditor has to re-derive. PIPE
# is trapped for the same reason: no byte reaches stdout or stderr between
# acquiring the lock and releasing it (the transaction's own output is captured
# in command substitutions and the result is emitted afterwards), so it cannot
# fire while the lock is held today — but that is a property of code in lib/
# rather than of anything guaranteed here, and a single warning added inside a
# future transaction would quietly reopen it. At the one point PIPE really can
# fire, the final emit into a closed pipe, the lock is already gone and the
# handler only changes a silent signal death into the same 141 exit status.
#
# QUIT is deliberately absent. Bash ignores SIGQUIT outright, so Ctrl-\ during
# a transaction does not interrupt it at all today — the run continues and
# finishes. Adding a QUIT handler would newly KILL runs that currently succeed,
# which is an availability regression bought for no safety at all, since the
# signal cannot free the lock it can never reach. Leave it alone.
#
# Both handlers stop taking every trapped signal before they do anything, so a
# second signal cannot re-enter cleanup that is already under way and leave the
# release half-done. afk_lock_release is exact-incarnation and idempotent, so
# the release the ordinary path already performed makes the one here a no-op
# rather than a second removal.
#
# The validator fixture directory an explicit live evaluation may have created
# is removed on the same boundary and for the same reason: it is the only path
# outside the state directory this executable ever creates, and a run that dies
# mid-probe must not leave it behind.
afk_release_on_exit() {
  trap '' "${AFK_TRAPPED_SIGNALS[@]}"
  afk_lock_release
  afk_validator_fixture_dir_remove
}

trap 'afk_release_on_exit' EXIT
afk_signal_traps_install

afk_main "$@"
exit $?
