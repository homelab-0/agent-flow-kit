#!/bin/bash -p
# AFK-owned release client. It fetches one immutable trust path into AFK state,
# qualifies an isolated checkout, and delegates installed-state mutation to a
# private snapshot of the already-installed lifecycle transaction engine.
# shellcheck disable=SC2016 # jq programs intentionally use jq variables
set -uo pipefail
# Bash imports exported functions before this script starts, and a function can
# shadow even a builtin. Release reconciliation accepts no caller-supplied
# executable helpers, so clear that ambient surface before defining our own.
builtin mapfile -t _afk_imported_functions < <(builtin compgen -A function)
for _afk_imported_function in "${_afk_imported_functions[@]}"; do
  builtin unset -f -- "$_afk_imported_function"
done
builtin unset _afk_imported_functions _afk_imported_function
PATH=/usr/bin:/bin
export PATH
builtin hash -r

readonly TRUST_REMOTE='ssh://git@github.com/jlengelbrecht/agent-flow-kit.git'
# The only stored origin a mirror may be migrated from. The repository is
# private, so this anchor never fetched; any other stored value still refuses.
readonly LEGACY_TRUST_REMOTE='https://github.com/jlengelbrecht/agent-flow-kit.git'
readonly TRUST_REF='refs/heads/master'
readonly TRUST_BRANCH='master'
readonly TRUST_ROOT='d74e7f9542cfe2731e09a0ff5c5e1b4cf325062f'
readonly GIT_BIN='/usr/bin/git'
readonly TIMEOUT_BIN='/usr/bin/timeout'
readonly TIMEOUT_FALLBACK_1='/usr/local/bin/gtimeout'
readonly TIMEOUT_FALLBACK_2='/opt/homebrew/bin/gtimeout'
readonly BWRAP_BIN='/usr/bin/bwrap'
readonly SHA256_BIN='/usr/bin/sha256sum'
readonly SHASUM_BIN='/usr/bin/shasum'
readonly REALPATH_BIN='/usr/bin/realpath'
readonly STAT_BIN='/usr/bin/stat'
readonly JQ_BIN='/usr/bin/jq'
readonly CP_BIN='/usr/bin/cp'
readonly DATE_BIN='/usr/bin/date'
readonly FIND_BIN='/usr/bin/find'
readonly SORT_BIN='/usr/bin/sort'
readonly READLINK_BIN='/usr/bin/readlink'
readonly SSH_BIN='/usr/bin/ssh'
readonly REQUIRE_TRUSTED_TOOLS=true

_self_parent="${BASH_SOURCE[0]%/*}"
[[ "$_self_parent" != "${BASH_SOURCE[0]}" ]] || _self_parent=.
SELF_DIR="$(cd -P -- "$_self_parent" && pwd -P)"
unset _self_parent
readonly TRUSTED_DRIVER_SOURCE="$SELF_DIR/.."
POLICY="$SELF_DIR/../lifecycle/release-policy.json"
# GitHub's published SSH host keys, shipped beside this client in the managed
# bin tree. They are the only host keys the fetch will accept.
readonly PINNED_KNOWN_HOSTS="$SELF_DIR/afk-release-known-hosts"
# Machine-local credential: a read-only deploy key for this one repository. It
# is read in place by ssh and never copied, logged, or recorded in results.
DEPLOY_KEY="${AFK_RELEASE_DEPLOY_KEY:-${HOME:+$HOME/.config/agent-flow-kit/deploy-key/agent-flow-kit_ed25519}}"
STATE_BASE="${XDG_STATE_HOME:-${HOME:+$HOME/.local/state}}"
STATE_DIR="${AFK_STATE_DIR:-${STATE_BASE:+$STATE_BASE/agent-flow-kit}}"
MODE=plan
COHORT=canary
FORCE=false
LOCK_HELD=false
LOCK_INCARNATION=""
ATTEMPT_ID=""
PRIOR_REVISION=""
TARGET_REVISION=""
PLAN_IDENTITY=""
OPERATION_ID=""
OPERATION_RESULT=""
OPERATION_REASON=""
APPLIED_REVISION=""
LAST_GOOD=false
LAST_GOOD_VERIFIED=false
STARTED_AT=""

usage() {
  printf '%s\n' \
    'usage: afk-release-reconcile [--plan|--apply] [--state-dir DIR]' \
    '                             [--policy FILE] [--cohort canary|wave]' \
    '                             [--force-check]' \
    '' \
    'The remote, ref, branch, and repository root are immutable trust anchors. The' \
    'cohort is observation metadata only; every enrolled host follows the same ref.'
}

while (( $# )); do
  case "$1" in
    --plan) MODE=plan ;;
    --apply) MODE=apply ;;
    --state-dir) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; STATE_DIR="$2"; shift ;;
    --policy) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; POLICY="$2"; shift ;;
    --cohort|--wave) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; COHORT="$2"; shift ;;
    --force-check) FORCE=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

now_epoch() { "$DATE_EXEC" +%s; }
sha_ok() { [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]]; }
file_contents_or_empty() {
  [[ -r "$1" ]] || return 0
  printf '%s' "$(<"$1")"
}
atomic_json_write() {
  local destination="$1" content="$2" temporary
  temporary="${destination}.tmp.${ATTEMPT_ID:-$$}"
  (umask 077; printf '%s\n' "$content" >"$temporary") || return 1
  chmod 600 "$temporary" 2>/dev/null || true
  mv -f -- "$temporary" "$destination"
}

release_root=""
attempt_dir=""
latest_file=""
current_file=""
lock_dir=""
mirror=""
candidate_root=""
QUALIFICATION_DIR=""
CANDIDATE_SANDBOX=""
DERIVED_SKILLS_HOME=""
DERIVED_CLAUDE_HOME=""
DERIVED_CODEX_HOME=""
GIT_EXEC=""
TIMEOUT_EXEC=""
HASH_EXEC=""
HASH_STYLE=""
REALPATH_EXEC=""
STAT_EXEC=""
JQ_EXEC=""
CP_EXEC=""
DATE_EXEC=""
FIND_EXEC=""
SORT_EXEC=""
READLINK_EXEC=""
SSH_EXEC=""
ACTIVE_CHILD_PID=""
ACTIVE_CHILD_PGID=""
ACTIVE_CHILD_TOKEN=""
ACTIVE_CHILD_GATE=""
CAPTURED_OUTPUT=""
QUALIFIED_CANDIDATE_ID=""
ACTIVE_OUTPUT_FILE=""
TRUSTED_DRIVER_DIR=""
GIT_ENV_COMMAND=()

process_start_identity() {
  local pid="$1" rest value
  if [[ -r "/proc/$pid/stat" ]]; then
    rest="$(sed 's/^.*) //' "/proc/$pid/stat" 2>/dev/null)" || return 1
    value="$(awk '{print $20}' <<<"$rest")"
    [[ -n "$value" ]] && { printf 'proc:%s\n' "$value"; return 0; }
  fi
  value="$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//')"
  [[ -n "$value" ]] || return 1
  printf 'ps:%s\n' "$value"
}

host_identity() {
  local machine host
  machine="$(file_contents_or_empty /etc/machine-id)"
  host="$(hostname 2>/dev/null || uname -n 2>/dev/null || true)"
  printf '%s|%s\n' "$host" "$machine"
}

boot_identity() {
  local boot
  boot="$(file_contents_or_empty /proc/sys/kernel/random/boot_id)"
  [[ -n "$boot" ]] || boot="$(awk '/^btime / {print $2}' /proc/stat 2>/dev/null)"
  [[ -n "$boot" ]] || boot=unknown
  printf '%s\n' "$boot"
}

new_incarnation() {
  local value
  value="$(file_contents_or_empty /proc/sys/kernel/random/uuid)"
  if [[ -z "$value" ]]; then
    if [[ "$HASH_STYLE" == sha256sum ]]; then
      value="$(printf '%s:%s:%s:%s' "$$" "$(now_epoch)" "$RANDOM" "$RANDOM" | "$HASH_EXEC" | awk '{print $1}')"
    else
      value="$(printf '%s:%s:%s:%s' "$$" "$(now_epoch)" "$RANDOM" "$RANDOM" | "$HASH_EXEC" -a 256 | awk '{print $1}')"
    fi
  fi
  printf '%s\n' "$value"
}

lock_owner_json() {
  local start host boot
  start="$(process_start_identity "$$")" || return 1
  host="$(host_identity)"; boot="$(boot_identity)"
  "$JQ_EXEC" -nc --arg host "$host" --arg boot "$boot" --argjson pid "$$" \
    --arg start "$start" --arg incarnation "$LOCK_INCARNATION" \
    '{schema:"afk-release-lock/1",complete:true,host:$host,boot:$boot,pid:$pid,
      process_start:$start,incarnation:$incarnation,child:null}'
}

lock_owner_is_dead() {
  local owner="$1" owner_host owner_boot pid expected actual child_state pgid leader leader_start
  "$JQ_EXEC" -e '.schema=="afk-release-lock/1" and .complete==true and
    (.pid|type=="number" and .>=2 and floor==.) and
    (.process_start|type=="string" and length>0) and
    (.incarnation|type=="string" and test("^[A-Za-z0-9-]{1,64}$")) and
    (.child == null or
      (.child|type=="object" and .state=="ACTIVE" and
       (.token|type=="string" and test("^[A-Za-z0-9-]{1,64}$"))))' \
    <<<"$owner" >/dev/null 2>&1 || return 1
  owner_host="$("$JQ_EXEC" -r '.host' <<<"$owner")"
  owner_boot="$("$JQ_EXEC" -r '.boot' <<<"$owner")"
  [[ "$owner_host" == "$(host_identity)" && "$owner_boot" == "$(boot_identity)" ]] || return 1
  pid="$("$JQ_EXEC" -r '.pid' <<<"$owner")"
  expected="$("$JQ_EXEC" -r '.process_start' <<<"$owner")"
  if kill -0 "$pid" 2>/dev/null; then
    actual="$(process_start_identity "$pid" 2>/dev/null || true)"
    [[ -n "$actual" && "$actual" != "$expected" ]] || return 1
  else
    [[ ! -d "/proc/$pid" ]] || return 1
    ps -p "$pid" >/dev/null 2>&1 && return 1
  fi

  child_state="$("$JQ_EXEC" -r '.child.state // "NONE"' <<<"$owner")"
  case "$child_state" in
    NONE) return 0 ;;
    ACTIVE)
      "$JQ_EXEC" -e '.child |
        (.pgid|type=="number" and .>=2 and floor==.) and
        (.leader_pid|type=="number" and .>=2 and floor==.) and
        (.leader_start|type=="string" and length>0)' <<<"$owner" >/dev/null 2>&1 || return 1
      pgid="$("$JQ_EXEC" -r '.child.pgid' <<<"$owner")"
      leader="$("$JQ_EXEC" -r '.child.leader_pid' <<<"$owner")"
      leader_start="$("$JQ_EXEC" -r '.child.leader_start' <<<"$owner")"
      # A surviving group keeps the old owner live even when its shell was
      # SIGKILLed. PID reuse is not used as evidence that the group is gone.
      process_group_exists "$pgid" && return 1
      if kill -0 "$leader" 2>/dev/null; then
        actual="$(process_start_identity "$leader" 2>/dev/null || true)"
        [[ -n "$actual" && "$actual" != "$leader_start" ]] || return 1
      fi
      return 0
      ;;
    *) return 1 ;;
  esac
}

recover_dead_lock() {
  local owner="$1" old_inc claim marker moved reread
  old_inc="$("$JQ_EXEC" -r '.incarnation' <<<"$owner")"
  claim="$release_root/.reclaim.${old_inc}.${LOCK_INCARNATION}"
  marker="$lock_dir/reclaim.${old_inc}"
  moved="$release_root/lock.stale.${old_inc}.${LOCK_INCARNATION}"
  (umask 077; printf '%s\n' "$LOCK_INCARNATION" >"$claim") || return 1
  if ! ln "$claim" "$marker" 2>/dev/null; then rm -f -- "$claim"; return 1; fi
  reread="$(file_contents_or_empty "$lock_dir/owner.json")"
  if [[ "$("$JQ_EXEC" -r '.incarnation // ""' <<<"$reread" 2>/dev/null)" != "$old_inc" ]] || ! lock_owner_is_dead "$reread"; then
    rm -f -- "$marker" "$claim"; return 1
  fi
  if ! mv -- "$lock_dir" "$moved" 2>/dev/null; then rm -f -- "$claim"; return 1; fi
  rm -rf -- "$moved"
  rm -f -- "$claim"
  return 0
}

acquire_lock() {
  local owner temporary attempts=0
  LOCK_INCARNATION="$(new_incarnation)"
  while (( attempts < 2 )); do
    attempts=$((attempts + 1))
    if mkdir "$lock_dir" 2>/dev/null; then
      owner="$(lock_owner_json)" || { rmdir "$lock_dir" 2>/dev/null; return 1; }
      temporary="$lock_dir/.owner.${LOCK_INCARNATION}"
      (umask 077; printf '%s\n' "$owner" >"$temporary") \
        || { rm -f -- "$temporary"; rmdir "$lock_dir" 2>/dev/null; return 1; }
      mv -- "$temporary" "$lock_dir/owner.json" || { rm -f -- "$temporary"; rmdir "$lock_dir" 2>/dev/null; return 1; }
      LOCK_HELD=true
      return 0
    fi
    owner="$(file_contents_or_empty "$lock_dir/owner.json")"
    lock_owner_is_dead "$owner" || return 2
    recover_dead_lock "$owner" || return 2
  done
  return 2
}

# shellcheck disable=SC2329 # invoked indirectly by the exit trap below
release_lock() {
  local owner moved
  [[ "$LOCK_HELD" == true ]] || return 0
  owner="$(file_contents_or_empty "$lock_dir/owner.json")"
  [[ "$("$JQ_EXEC" -r '.incarnation // ""' <<<"$owner" 2>/dev/null)" == "$LOCK_INCARNATION" ]] || return 0
  [[ "$("$JQ_EXEC" -r '.child == null' <<<"$owner" 2>/dev/null)" == true ]] || return 0
  moved="$release_root/lock.released.${LOCK_INCARNATION}"
  if mv -- "$lock_dir" "$moved" 2>/dev/null; then rm -rf -- "$moved"; fi
  LOCK_HELD=false
}

qualification_dir_remove() {
  [[ -n "$release_root" && "$QUALIFICATION_DIR" == "$release_root"/.qualification.* ]] || return 0
  rm -rf -- "$QUALIFICATION_DIR"
  QUALIFICATION_DIR=""
}

trusted_driver_dir_remove() {
  [[ -n "$release_root" && "$TRUSTED_DRIVER_DIR" == "$release_root"/.trusted-driver.* ]] || return 0
  rm -rf -- "$TRUSTED_DRIVER_DIR"
  TRUSTED_DRIVER_DIR=""
}

RELEASE_TRAPPED_SIGNALS=()

write_lock_child() {
  local state="$1" token="$2" pgid="${3:-}" leader="${4:-}" leader_start="${5:-}"
  local owner updated temporary
  [[ "$LOCK_HELD" == true ]] || return 0
  owner="$(file_contents_or_empty "$lock_dir/owner.json")"
  [[ "$("$JQ_EXEC" -r '.incarnation // ""' <<<"$owner" 2>/dev/null)" == "$LOCK_INCARNATION" ]] || return 1
  if [[ "$state" == ACTIVE ]]; then
    [[ "$pgid" =~ ^[0-9]+$ && "$leader" =~ ^[0-9]+$ && -n "$leader_start" ]] || return 1
    updated="$("$JQ_EXEC" -c --arg token "$token" --arg start "$leader_start" \
      --argjson pgid "$pgid" --argjson leader "$leader" \
      'if .child == null then
         .child={state:"ACTIVE",token:$token,pgid:$pgid,leader_pid:$leader,leader_start:$start}
       else error("child owner moved") end' <<<"$owner")" || return 1
  else
    updated="$("$JQ_EXEC" -c --arg token "$token" \
      'if .child != null and .child.token==$token then .child=null
       else error("child owner moved") end' <<<"$owner")" || return 1
  fi
  temporary="$lock_dir/.owner.${LOCK_INCARNATION}.${token}"
  if ! (umask 077; printf '%s\n' "$updated" >"$temporary") \
      || ! mv -- "$temporary" "$lock_dir/owner.json"; then
    rm -f -- "$temporary"
    return 1
  fi
}

process_group_exists() {
  local target="${1:-}" proc_stat record suffix state pgrp zombie_seen=false
  [[ "$target" =~ ^[0-9]+$ ]] || return 0
  kill -0 -- "-$target" 2>/dev/null || return 1
  # Linux can retain an orphan as a zombie after every executable member has
  # exited. A zombie cannot mutate release state and must not pin the lock
  # forever. /proc is the qualified Linux backend for this Linux-only updater;
  # an unclassifiable signalled group remains conservatively live.
  for proc_stat in /proc/[0-9]*/stat; do
    IFS= read -r record <"$proc_stat" 2>/dev/null || continue
    suffix="${record##*) }"
    read -r state _ pgrp _ <<<"$suffix"
    [[ "$pgrp" == "$target" ]] || continue
    if [[ "$state" == Z ]]; then zombie_seen=true; else return 0; fi
  done
  [[ "$zombie_seen" == true ]] && return 1
  return 0
}

clear_active_child() {
  local token="$ACTIVE_CHILD_TOKEN" owner recorded
  [[ -n "$token" ]] || return 0
  process_group_exists "$ACTIVE_CHILD_PGID" && return 1
  owner="$(file_contents_or_empty "$lock_dir/owner.json")"
  recorded="$("$JQ_EXEC" -r '.child.token // ""' <<<"$owner" 2>/dev/null || true)"
  if [[ "$recorded" == "$token" ]]; then
    write_lock_child CLEAR "$token" || return 1
  elif [[ -n "$recorded" ]]; then
    return 1
  fi
  [[ -z "$ACTIVE_CHILD_GATE" || "$ACTIVE_CHILD_GATE" != "$release_root"/.child-start.* ]] \
    || rm -f -- "$ACTIVE_CHILD_GATE"
  ACTIVE_CHILD_PID=""; ACTIVE_CHILD_PGID=""
  ACTIVE_CHILD_TOKEN=""; ACTIVE_CHILD_GATE=""
}

# shellcheck disable=SC2329 # invoked directly and indirectly by signal/EXIT traps
terminate_active_child() {
  [[ -n "$ACTIVE_CHILD_PID" && "$ACTIVE_CHILD_PID" =~ ^[0-9]+$ ]] || return 0
  if process_group_exists "$ACTIVE_CHILD_PGID" || kill -0 "$ACTIVE_CHILD_PID" 2>/dev/null; then
    kill -TERM -- "-$ACTIVE_CHILD_PGID" 2>/dev/null || kill -TERM "$ACTIVE_CHILD_PID" 2>/dev/null || true
    for _ in {1..50}; do
      if ! process_group_exists "$ACTIVE_CHILD_PGID" && ! kill -0 "$ACTIVE_CHILD_PID" 2>/dev/null; then
        break
      fi
      /bin/sleep 0.02
    done
    if process_group_exists "$ACTIVE_CHILD_PGID" || kill -0 "$ACTIVE_CHILD_PID" 2>/dev/null; then
      kill -KILL -- "-$ACTIVE_CHILD_PGID" 2>/dev/null || kill -KILL "$ACTIVE_CHILD_PID" 2>/dev/null || true
    fi
  fi
  wait "$ACTIVE_CHILD_PID" 2>/dev/null || true
  for _ in {1..50}; do
    process_group_exists "$ACTIVE_CHILD_PGID" || break
    /bin/sleep 0.02
  done
  process_group_exists "$ACTIVE_CHILD_PGID" && return 1
  clear_active_child
}

child_pre_publish_boundary() { :; }

run_tracked() {
  local rc token gate leader_start owner_start owner_pid="$$" owner_inc="$LOCK_INCARNATION"
  token="$(new_incarnation)"
  gate="$release_root/.child-start.$token"
  owner_start="$(process_start_identity "$$")" || return 126
  ACTIVE_CHILD_TOKEN="$token"; ACTIVE_CHILD_GATE="$gate"
  set -m
  (
    trap 'exit 143' TERM HUP INT QUIT
    while [[ ! -e "$gate" ]]; do
      [[ "$(process_start_identity "$owner_pid" 2>/dev/null || true)" == "$owner_start" ]] || exit 125
      child_owner="$(file_contents_or_empty "$lock_dir/owner.json")"
      [[ "$("$JQ_EXEC" -r '.incarnation // ""' <<<"$child_owner" 2>/dev/null)" == "$owner_inc" ]] || exit 125
      /bin/sleep 0.01
    done
    exec "$@"
  ) &
  ACTIVE_CHILD_PID=$!; ACTIVE_CHILD_PGID=$ACTIVE_CHILD_PID
  set +m
  child_pre_publish_boundary "$ACTIVE_CHILD_PID" "$ACTIVE_CHILD_PGID" "$gate"
  leader_start="$(process_start_identity "$ACTIVE_CHILD_PID" 2>/dev/null || true)"
  if [[ -z "$leader_start" ]] || ! write_lock_child ACTIVE "$token" \
      "$ACTIVE_CHILD_PGID" "$ACTIVE_CHILD_PID" "$leader_start"; then
    terminate_active_child || true
    return 126
  fi
  : >"$gate" || { terminate_active_child || true; return 126; }
  wait "$ACTIVE_CHILD_PID"
  rc=$?
  # The leader may exit after forking work that remains in its process group.
  # Do not clear owner metadata or release the lock until that group is gone.
  terminate_active_child || return 126
  return "$rc"
}

run_tracked_capture() {
  local output="$release_root/.child-output.${ATTEMPT_ID:-$$}" rc
  CAPTURED_OUTPUT=""
  (umask 077; : >"$output") || return 1
  ACTIVE_OUTPUT_FILE="$output"
  run_tracked "$@" >"$output"
  rc=$?
  CAPTURED_OUTPUT="$(file_contents_or_empty "$output")"
  rm -f -- "$output"
  ACTIVE_OUTPUT_FILE=""
  return "$rc"
}
# shellcheck disable=SC2329 # invoked indirectly by the EXIT trap below
release_on_exit() {
  trap '' "${RELEASE_TRAPPED_SIGNALS[@]}"
  terminate_active_child
  if [[ -n "$release_root" && "$ACTIVE_OUTPUT_FILE" == "$release_root"/.child-output.* ]]; then
    rm -f -- "$ACTIVE_OUTPUT_FILE"
  fi
  qualification_dir_remove
  trusted_driver_dir_remove
  release_lock
}
# shellcheck disable=SC2329 # invoked indirectly by the signal traps below
terminate_on_signal() {
  trap '' "${RELEASE_TRAPPED_SIGNALS[@]}"
  terminate_active_child
  exit "$1"
}
trap 'release_on_exit' EXIT
for signal_name in HUP INT QUIT ILL TRAP ABRT BUS FPE USR1 SEGV USR2 PIPE ALRM \
    TERM STKFLT XCPU XFSZ VTALRM PROF IO PWR SYS EMT; do
  signal_number="$(kill -l "$signal_name" 2>/dev/null || true)"
  if [[ "$signal_number" =~ ^[0-9]+$ ]]; then
    RELEASE_TRAPPED_SIGNALS+=("$signal_name")
    signal_code=$((128 + signal_number))
    # shellcheck disable=SC2064 # bind this iteration's numeric exit now
    trap "terminate_on_signal $signal_code" "$signal_name"
  fi
done
unset signal_name signal_number signal_code

read_applied() {
  APPLIED_REVISION="$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null || true)"
  sha_ok "$APPLIED_REVISION" || APPLIED_REVISION=""
}

attempt_document() {
  local state="$1" reason="$2" ended
  ended="$("$DATE_EXEC" -u +%Y-%m-%dT%H:%M:%SZ)"
  "$JQ_EXEC" -nc \
    --arg id "$ATTEMPT_ID" --arg mode "$MODE" --arg cohort "$COHORT" \
    --arg started "$STARTED_AT" --arg ended "$ended" \
    --arg state "$state" --arg reason "$reason" --arg prior "$PRIOR_REVISION" \
    --arg target "$TARGET_REVISION" --arg applied "$APPLIED_REVISION" \
    --arg plan "$PLAN_IDENTITY" --arg operation_id "$OPERATION_ID" \
    --arg operation_result "$OPERATION_RESULT" --arg operation_reason "$OPERATION_REASON" \
    --argjson retained "$LAST_GOOD" --argjson verified "$LAST_GOOD_VERIFIED" \
    '{schema:"afk-release-result/2",attempt_id:$id,mode:$mode,cohort:$cohort,
      rollout_authoritative:false,started_at:$started,ended_at:$ended,state:$state,reason:$reason,
      remote_ref:"refs/heads/master",prior_revision:(if $prior=="" then null else $prior end),
      target_revision:(if $target=="" then null else $target end),
      applied_revision:(if $applied=="" then null else $applied end),
      plan_identity:(if $plan=="" then null else $plan end),
      operation:{id:(if $operation_id=="" then null else $operation_id end),result:(if $operation_result=="" then null else $operation_result end),reason:(if $operation_reason=="" then null else $operation_reason end)},
      last_good_retained:$retained,last_good_verified:$verified}'
}

finish() {
  local state="$1" reason="$2" code="${3:-0}" publish_latest="${4:-true}" doc failure_doc
  local persistence_failed=false
  read_applied
  doc="$(attempt_document "$state" "$reason")"
  if [[ -n "$attempt_dir" && -d "$attempt_dir" ]]; then
    if ! atomic_json_write "$attempt_dir/$ATTEMPT_ID.json" "$doc"; then
      persistence_failed=true
    elif [[ "$publish_latest" == true ]]; then
      atomic_json_write "$latest_file" "$doc" || persistence_failed=true
    fi
  else
    persistence_failed=true
  fi
  if [[ "$persistence_failed" == true ]]; then
    failure_doc="$("$JQ_EXEC" -c \
      '.state="BLOCKED" | .reason="RESULT_PERSISTENCE_FAILED"' <<<"$doc" 2>/dev/null || true)"
    [[ -n "$failure_doc" ]] || failure_doc='{"schema":"afk-release-result/2","state":"BLOCKED","reason":"RESULT_PERSISTENCE_FAILED","last_good_retained":false,"last_good_verified":false}'
    printf '%s\n' "$failure_doc"
    exit 2
  fi
  printf '%s\n' "$doc"
  exit "$code"
}

validate_policy() {
  [[ -r "$POLICY" ]] || return 1
  "$JQ_EXEC" -e --arg remote "$TRUST_REMOTE" --arg ref "$TRUST_REF" --arg branch "$TRUST_BRANCH" --arg root "$TRUST_ROOT" '
    .schema=="afk-release-policy/2" and .trust.remote_url==$remote and .trust.ref==$ref and
    .trust.default_branch==$branch and .trust.repository_root_commit==$root and
    (.fetch_timeout_seconds|type=="number" and .>=1 and .<=300) and
    (.qualification_timeout_seconds|type=="number" and .>=1 and .<=600) and
    (.check_interval_seconds|type=="number" and .>=0 and .<=86400) and
    .offline_fallback=="RETAIN_PROVEN_LAST_GOOD" and
    .rollout.mode=="cohort_metadata_only" and .rollout.authoritative_promotion==false and
    .automatic_rollback_bypass==false
  ' "$POLICY" >/dev/null 2>&1
}

prepare_state() {
  local resolved requested owner
  [[ -n "$STATE_DIR" && "$STATE_DIR" == /* ]] || return 1
  mkdir -p -- "$STATE_DIR" || return 1
  requested="$("$REALPATH_EXEC" -m -s -- "$STATE_DIR" 2>/dev/null)" || return 1
  resolved="$(cd -P -- "$STATE_DIR" 2>/dev/null && pwd -P)" || return 1
  [[ "$requested" == "$resolved" && ! -L "$STATE_DIR" ]] || return 1
  owner="$("$STAT_EXEC" -c %u "$STATE_DIR" 2>/dev/null)"
  [[ "$owner" == "$(id -u)" ]] || return 1
  chmod 700 "$STATE_DIR" || return 1
  release_root="$STATE_DIR/releases"
  attempt_dir="$release_root/attempts"; latest_file="$release_root/latest.json"
  current_file="$release_root/current.json"; lock_dir="$release_root/lock"
  mirror="$release_root/repository.git"; candidate_root="$release_root/candidates"
  local protected
  for protected in "$release_root" "$attempt_dir" "$candidate_root" "$mirror" \
      "$latest_file" "$current_file"; do
    [[ ! -L "$protected" ]] || return 1
  done
  mkdir -p -- "$attempt_dir" "$candidate_root" || return 1
  chmod 700 "$release_root" "$attempt_dir" "$candidate_root" 2>/dev/null || return 1
  return 0
}

trusted_absolute_executable() {
  local requested="$1" resolved owner permissions cursor parent
  [[ "$requested" == /* && -e "$requested" ]] || return 1
  resolved="$("$REALPATH_BIN" -e -- "$requested" 2>/dev/null)" || return 1
  [[ "$resolved" == /* && -f "$resolved" && -x "$resolved" ]] || return 1
  cursor="$resolved"
  while :; do
    owner="$("$STAT_BIN" -c %u "$cursor" 2>/dev/null)" || return 1
    permissions="$("$STAT_BIN" -c %a "$cursor" 2>/dev/null)" || return 1
    [[ "$owner" == 0 && "$permissions" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#$permissions & 8#22) == 0 )) || return 1
    [[ "$cursor" == / ]] && break
    parent="${cursor%/*}"; [[ -n "$parent" ]] || parent=/
    cursor="$parent"
  done
  printf '%s\n' "$resolved"
}

validate_release_tools() {
  if [[ "$REQUIRE_TRUSTED_TOOLS" == true ]]; then
    REALPATH_EXEC="$(trusted_absolute_executable "$REALPATH_BIN")" || return 1
    STAT_EXEC="$(trusted_absolute_executable "$STAT_BIN")" || return 1
    JQ_EXEC="$(trusted_absolute_executable "$JQ_BIN")" || return 1
    CP_EXEC="$(trusted_absolute_executable "$CP_BIN")" || return 1
    DATE_EXEC="$(trusted_absolute_executable "$DATE_BIN")" || return 1
    FIND_EXEC="$(trusted_absolute_executable "$FIND_BIN")" || return 1
    SORT_EXEC="$(trusted_absolute_executable "$SORT_BIN")" || return 1
    READLINK_EXEC="$(trusted_absolute_executable "$READLINK_BIN")" || return 1
    GIT_EXEC="$(trusted_absolute_executable "$GIT_BIN")" || return 1
    TIMEOUT_EXEC="$(trusted_absolute_executable "$TIMEOUT_BIN" 2>/dev/null ||
      trusted_absolute_executable "$TIMEOUT_FALLBACK_1" 2>/dev/null ||
      trusted_absolute_executable "$TIMEOUT_FALLBACK_2" 2>/dev/null)" || return 1
    if HASH_EXEC="$(trusted_absolute_executable "$SHA256_BIN" 2>/dev/null)"; then
      HASH_STYLE=sha256sum
    else
      HASH_EXEC="$(trusted_absolute_executable "$SHASUM_BIN" 2>/dev/null)" || return 1
      HASH_STYLE=shasum
    fi
    # ssh is needed only by the network fetch; its absence is reported there
    # so an offline proof of the last-good release still works without it.
    SSH_EXEC="$(trusted_absolute_executable "$SSH_BIN" 2>/dev/null)" || SSH_EXEC=""
  else
    [[ "$REALPATH_BIN" == /* && -x "$REALPATH_BIN" && "$STAT_BIN" == /* && -x "$STAT_BIN" &&
       "$JQ_BIN" == /* && -x "$JQ_BIN" && "$CP_BIN" == /* && -x "$CP_BIN" &&
       "$DATE_BIN" == /* && -x "$DATE_BIN" && "$FIND_BIN" == /* && -x "$FIND_BIN" &&
       "$SORT_BIN" == /* && -x "$SORT_BIN" && "$READLINK_BIN" == /* && -x "$READLINK_BIN" &&
       "$GIT_BIN" == /* && -x "$GIT_BIN" &&
       "$TIMEOUT_BIN" == /* && -x "$TIMEOUT_BIN" && "$SHA256_BIN" == /* && -x "$SHA256_BIN" ]] || return 1
    REALPATH_EXEC="$REALPATH_BIN"; STAT_EXEC="$STAT_BIN"; JQ_EXEC="$JQ_BIN"
    CP_EXEC="$CP_BIN"; DATE_EXEC="$DATE_BIN"; FIND_EXEC="$FIND_BIN"
    SORT_EXEC="$SORT_BIN"; READLINK_EXEC="$READLINK_BIN"
    GIT_EXEC="$GIT_BIN"; TIMEOUT_EXEC="$TIMEOUT_BIN"
    HASH_EXEC="$SHA256_BIN"; HASH_STYLE=sha256sum
    SSH_EXEC=""
    if [[ "$SSH_BIN" == /* && -x "$SSH_BIN" ]]; then SSH_EXEC="$SSH_BIN"; fi
  fi
}

sha256_file_identity() {
  local output digest
  [[ -f "$1" ]] || return 1
  if [[ "$HASH_STYLE" == sha256sum ]]; then
    output="$("$HASH_EXEC" "$1")" || return 1
  else
    output="$("$HASH_EXEC" -a 256 "$1")" || return 1
  fi
  digest="${output%% *}"
  [[ "$digest" =~ ^[0-9a-fA-F]{64}$ ]] || return 1
  printf 'sha256:%s\n' "${digest,,}"
}

encode_tree_path() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

driver_tree_identity() {
  local root="$1" entry rel target digest listing="" hash_output tree_digest
  [[ "$root" == /* && -d "$root" && ! -L "$root" ]] || return 1
  while IFS= read -r -d '' entry; do
    case "$entry" in
      FINDRC=0) break ;;
      FINDRC=*) return 1 ;;
    esac
    rel="${entry#"$root"/}"
    [[ "$rel" != "$entry" ]] || rel="${entry##*/}"
    if [[ -L "$entry" ]]; then
      target="$("$READLINK_EXEC" -- "$entry")" || return 1
      listing+="L $(encode_tree_path "$target") $(encode_tree_path "$rel")"$'\n'
    else
      digest="$(sha256_file_identity "$entry")" || return 1
      listing+="F $digest $(encode_tree_path "$rel")"$'\n'
    fi
  done < <("$FIND_EXEC" "$root" \( -type f -o -type l \) -print0 2>/dev/null
           printf 'FINDRC=%s\0' "$?")
  if [[ "$HASH_STYLE" == sha256sum ]]; then
    hash_output="$(printf '%s' "$listing" | LC_ALL=C "$SORT_EXEC" | "$HASH_EXEC")" || return 1
  else
    hash_output="$(printf '%s' "$listing" | LC_ALL=C "$SORT_EXEC" | "$HASH_EXEC" -a 256)" || return 1
  fi
  tree_digest="${hash_output%% *}"
  [[ "$tree_digest" =~ ^[0-9a-fA-F]{64}$ ]] || return 1
  printf 'sha256:%s\n' "${tree_digest,,}"
}

resolve_candidate_sandbox() {
  if [[ "$REQUIRE_TRUSTED_TOOLS" == true ]]; then
    CANDIDATE_SANDBOX="$(trusted_absolute_executable "$BWRAP_BIN")" || return 1
  else
    [[ "$BWRAP_BIN" == /* && -x "$BWRAP_BIN" ]] || return 1
    CANDIDATE_SANDBOX="$BWRAP_BIN"
  fi
}

candidate_sandbox_command() {
  local candidate="$1" state="$2" bound="$3" seconds="$4"
  shift 4
  local -a args
  args=(--unshare-all --die-with-parent --new-session --clearenv
    --setenv PATH /usr/bin:/bin --setenv LANG C --setenv LC_ALL C
    --setenv AFK_STATE_DIR /state --proc /proc --dev /dev --tmpfs /tmp)
  local system_dir
  for system_dir in /usr /bin /lib /lib64; do
    [[ -e "$system_dir" ]] && args+=(--ro-bind "$system_dir" "$system_dir")
  done
  args+=(--dir /candidate --ro-bind "$candidate" /candidate
    --dir /state --bind "$state" /state --chdir /candidate)
  run_tracked_capture "$bound" "$seconds" "$CANDIDATE_SANDBOX" "${args[@]}" "$@"
}

derive_candidate_destinations() {
  local manifest="$STATE_DIR/state.json" router_path claude_path codex_path
  local router_real claude_real codex_real home_from_router home_from_claude home_from_codex
  [[ -r "$manifest" ]] || return 1
  router_path="$("$JQ_EXEC" -r '.components["model-router"].path // ""' "$manifest" 2>/dev/null)"
  claude_path="$("$JQ_EXEC" -r '.components["claude-global-policy"].path // ""' "$manifest" 2>/dev/null)"
  codex_path="$("$JQ_EXEC" -r '.components["codex-global-guidance"].path // ""' "$manifest" 2>/dev/null)"
  [[ "$router_path" == /* && "$claude_path" == /* && "$codex_path" == /* &&
     -d "$router_path" && -f "$claude_path" && -f "$codex_path" ]] || return 1
  router_real="$("$REALPATH_EXEC" -e -- "$router_path" 2>/dev/null)" || return 1
  claude_real="$("$REALPATH_EXEC" -e -- "$claude_path" 2>/dev/null)" || return 1
  codex_real="$("$REALPATH_EXEC" -e -- "$codex_path" 2>/dev/null)" || return 1
  [[ "$router_path" == "$router_real" && "$claude_path" == "$claude_real" &&
     "$codex_path" == "$codex_real" ]] || return 1
  home_from_router="${router_real%/.agents/skills/model-router}"
  home_from_claude="${claude_real%/.claude/CLAUDE.md}"
  home_from_codex="${codex_real%/.codex/AGENTS.md}"
  [[ -n "$home_from_router" && "$home_from_router" != "$router_real" &&
     "$home_from_router" == "$home_from_claude" && "$home_from_router" == "$home_from_codex" &&
     "$router_real" == "$home_from_router/.agents/skills/model-router" &&
     "$claude_real" == "$home_from_router/.claude/CLAUDE.md" &&
     "$codex_real" == "$home_from_router/.codex/AGENTS.md" ]] || return 1
  DERIVED_SKILLS_HOME="$home_from_router/.agents/skills"
  DERIVED_CLAUDE_HOME="$home_from_router/.claude"
  DERIVED_CODEX_HOME="$home_from_router/.codex"
}

prepare_trusted_driver() {
  local source_root snapshot_file library
  local recorded_bin_path recorded_lib_path recorded_bin_identity recorded_lib_identity
  local -a libraries=(afk-common afk-source afk-inventory afk-readiness
    afk-monitor afk-commands afk-plan afk-mutate)
  source_root="$(cd -P -- "$TRUSTED_DRIVER_SOURCE" 2>/dev/null && pwd -P)" || return 1
  [[ "$source_root" == /* && -x "$source_root/bin/agent-flow-kit" &&
     ! -L "$source_root/bin/agent-flow-kit" && -d "$source_root/lib" &&
     ! -L "$source_root/lib" ]] || return 1
  recorded_bin_path="$("$JQ_EXEC" -r '.components["afk-runtime-bin"].path // ""' "$STATE_DIR/state.json" 2>/dev/null)" || return 1
  recorded_lib_path="$("$JQ_EXEC" -r '.components["afk-runtime-lib"].path // ""' "$STATE_DIR/state.json" 2>/dev/null)" || return 1
  recorded_bin_identity="$("$JQ_EXEC" -r '.components["afk-runtime-bin"].identity // ""' "$STATE_DIR/state.json" 2>/dev/null)" || return 1
  recorded_lib_identity="$("$JQ_EXEC" -r '.components["afk-runtime-lib"].identity // ""' "$STATE_DIR/state.json" 2>/dev/null)" || return 1
  [[ "$recorded_bin_path" == "$source_root/bin" &&
     "$recorded_lib_path" == "$source_root/lib" &&
     "$recorded_bin_identity" =~ ^sha256:[0-9a-f]{64}$ &&
     "$recorded_lib_identity" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1

  TRUSTED_DRIVER_DIR="$(mktemp -d "$release_root/.trusted-driver.XXXXXX")" || return 1
  mkdir -p -- "$TRUSTED_DRIVER_DIR/bin" "$TRUSTED_DRIVER_DIR/lib" \
    || { trusted_driver_dir_remove; return 1; }
  "$CP_EXEC" -R -- "$source_root/bin/." "$TRUSTED_DRIVER_DIR/bin/" \
    || { trusted_driver_dir_remove; return 1; }
  "$CP_EXEC" -R -- "$source_root/lib/." "$TRUSTED_DRIVER_DIR/lib/" \
    || { trusted_driver_dir_remove; return 1; }
  [[ "$(driver_tree_identity "$TRUSTED_DRIVER_DIR/bin")" == "$recorded_bin_identity" &&
     "$(driver_tree_identity "$TRUSTED_DRIVER_DIR/lib")" == "$recorded_lib_identity" ]] \
    || { trusted_driver_dir_remove; return 1; }
  snapshot_file="$TRUSTED_DRIVER_DIR/bin/agent-flow-kit"
  [[ -f "$snapshot_file" && -x "$snapshot_file" && ! -L "$snapshot_file" ]] \
    || { trusted_driver_dir_remove; return 1; }
  for library in "${libraries[@]}"; do
    snapshot_file="$TRUSTED_DRIVER_DIR/lib/$library.sh"
    [[ -f "$snapshot_file" && ! -L "$snapshot_file" ]] \
      || { trusted_driver_dir_remove; return 1; }
  done
  chmod 700 "$TRUSTED_DRIVER_DIR" "$TRUSTED_DRIVER_DIR/bin" "$TRUSTED_DRIVER_DIR/lib" \
    || { trusted_driver_dir_remove; return 1; }
  chmod 500 "$TRUSTED_DRIVER_DIR/bin/agent-flow-kit" \
    || { trusted_driver_dir_remove; return 1; }
  chmod 400 "$TRUSTED_DRIVER_DIR"/lib/*.sh \
    || { trusted_driver_dir_remove; return 1; }
  env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C /bin/bash -p -n \
    "$TRUSTED_DRIVER_DIR/bin/agent-flow-kit" >/dev/null 2>&1 \
    || { trusted_driver_dir_remove; return 1; }
  for library in "${libraries[@]}"; do
    env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C /bin/bash -p -n \
      "$TRUSTED_DRIVER_DIR/lib/$library.sh" >/dev/null 2>&1 \
      || { trusted_driver_dir_remove; return 1; }
  done
}

# Git's ambient environment is not part of the release trust contract. Start
# every invocation from an empty environment so repository/work-tree/index and
# object-directory selectors, credential helpers, askpass/SSH controls, config
# injection, and transport overrides cannot redirect reads, writes, or process
# execution. The fetch alone adds one explicit GIT_SSH_COMMAND (see
# release_ssh_command). Focused tests use only the explicitly named seams.
prepare_git_environment() {
  local name
  GIT_ENV_COMMAND=(env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C HOME=/nonexistent
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_GLOBAL=/dev/null
    GIT_CONFIG_COUNT=0 GIT_SSL_NO_VERIFY=false GIT_TERMINAL_PROMPT=0)
  if [[ "$REQUIRE_TRUSTED_TOOLS" != true ]]; then
    for name in AFK_TEST_GIT_ENV_MARKER AFK_TEST_SSH_CAPTURE AFK_TEST_SSH_STDERR AFK_TEST_FETCH_EXECUTED AFK_TEST_FETCH_FAIL AFK_TEST_FETCH_ORPHAN_START \
      AFK_TEST_FETCH_ORPHAN_TERMINATING AFK_TEST_FETCH_ORPHAN_RELEASE \
      AFK_TEST_FETCH_PARKED AFK_TEST_FETCH_RELEASE AFK_TEST_CHILD_TERMINATING; do
      [[ -v "$name" ]] && GIT_ENV_COMMAND+=("$name=${!name}")
    done
  fi
}

trusted_git() {
  "${GIT_ENV_COMMAND[@]}" "$GIT_EXEC" -c http.sslVerify=true "$@"
}

# Quote one word for the POSIX shell through which git runs GIT_SSH_COMMAND.
sh_quote() {
  local quote="'" escaped="'\\''"
  printf "'%s'" "${1//"$quote"/"$escaped"}"
}

# The deploy key must be the user's own regular file (never a link) with mode
# 0600, and must not live inside the managed runtime or the release state tree.
# Every directory above it, up to $HOME (or / outside it), must be owned by the
# user or root and not group/world-writable, as OpenSSH checks its own files.
deploy_key_is_usable() {
  local key="$DEPLOY_KEY" runtime_root state_root real_key uid dir home owner mode
  uid="$(id -u)"
  [[ -n "$key" && "$key" == /* ]] || return 1
  [[ ! -L "$key" && -f "$key" && -r "$key" ]] || return 1
  [[ "$("$STAT_EXEC" -c %u "$key" 2>/dev/null)" == "$uid" ]] || return 1
  [[ "$("$STAT_EXEC" -c %a "$key" 2>/dev/null)" == 600 ]] || return 1
  # Compare physical paths, so a symlinked parent or `..` cannot hide the key
  # inside the managed runtime or the release state tree.
  dir="$(cd -P -- "${key%/*}/" 2>/dev/null && pwd -P)" || return 1
  real_key="${dir%/}/${key##*/}"
  runtime_root="$(cd -P -- "$TRUSTED_DRIVER_SOURCE" 2>/dev/null && pwd -P)" || return 1
  state_root="$(cd -P -- "$STATE_DIR" 2>/dev/null && pwd -P)" || return 1
  case "$real_key" in "$runtime_root"/*|"$state_root"/*) return 1 ;; esac
  home="$(cd -P -- "${HOME:-/}" 2>/dev/null && pwd -P)" || home=/
  [[ "$dir" == "$home" || "$dir" == "$home"/* ]] || home=/
  while :; do
    read -r owner mode < <("$STAT_EXEC" -c '%u %a' "$dir" 2>/dev/null) || return 1
    [[ ("$owner" == "$uid" || "$owner" == 0) && "$mode" =~ ^[0-7]+$ ]] || return 1
    (( (8#$mode & 8#022) == 0 )) || return 1
    [[ "$dir" != "$home" && "$dir" != / ]] || return 0
    dir="${dir%/*}"; dir="${dir:-/}"
  done
}

# The single transport customization: ssh with only the deploy key and only the
# pinned GitHub host keys. -F /dev/null skips every user and system ssh config
# (ssh finds ~/.ssh through the password database, not $HOME); the agent,
# global known_hosts, and host-key updates are all switched off explicitly.
release_ssh_command() {
  printf '%s -F /dev/null -i %s -o IdentitiesOnly=yes -o IdentityAgent=none -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%s -o GlobalKnownHostsFile=/dev/null -o UpdateHostKeys=no -o PreferredAuthentications=publickey -o BatchMode=yes -o ConnectTimeout=10' \
    "$(sh_quote "$SSH_EXEC")" "$(sh_quote "$DEPLOY_KEY")" "$(sh_quote "$PINNED_KNOWN_HOSTS")"
}

mirror_config_is_exact() {
  local keys
  keys="$(trusted_git --git-dir="$mirror" config --local --name-only --list 2>/dev/null)" || return 1
  while IFS= read -r key; do
    case "$key" in
      core.repositoryformatversion|core.filemode|core.bare|remote.origin.url|remote.origin.fetch) : ;;
      '') : ;;
      *) return 1 ;;
    esac
  done <<<"$keys"
  return 0
}

validate_commit() {
  local revision="$1" roots kit
  sha_ok "$revision" || return 1
  trusted_git --git-dir="$mirror" cat-file -e "$revision^{commit}" 2>/dev/null || return 1
  roots="$(trusted_git --git-dir="$mirror" rev-list --max-parents=0 "$revision" 2>/dev/null)" || return 1
  [[ "$roots" == "$TRUST_ROOT" ]] || return 1
  kit="$(trusted_git --git-dir="$mirror" show "$revision:lifecycle/kit.json" 2>/dev/null)" || return 1
  "$JQ_EXEC" -e --arg branch "$TRUST_BRANCH" '
    .kit_id=="agent-flow-kit" and .lifecycle_schema_version=="1.0" and
    .state_schema_version=="1.0" and .default_branch==$branch and
    (.managed_inputs|type=="array" and length>0) and
    all(.managed_inputs[]; type=="string" and length>0 and
      ((startswith("/"))|not) and ((test("(^|/)\\.\\.(/|$)"))|not)) and
    (["bin","lib","lifecycle","files"] - .managed_inputs | length)==0
  ' <<<"$kit" >/dev/null 2>&1
}

# Map the fetch's stderr, by fixed strings only, to a reason code. The raw text
# is never persisted: it may name key files or carry remote-supplied output.
classify_fetch_failure() { # <stderr text>
  case "$1" in
    *"Host key verification failed"*|*"REMOTE HOST IDENTIFICATION HAS CHANGED"*) return 20 ;;
    *"Permission denied (publickey)"*) return 21 ;;
    *"ERROR: Repository not found."*) return 23 ;;
  esac
  return 14
}

# OpenSSH re-parses -i and -o values (quotes, escapes, %-tokens, comments), so a
# path holding any of those characters could be read as a different file.
ssh_option_path_is_safe() { # <path>
  [[ -n "$1" && "$1" != *[[:space:]\'\"\\%#]* ]]
}

fetch_candidate_revision() {
  local bound fetch_seconds url shallow fetch_error fetch_stderr fetch_rc
  bound="$TIMEOUT_EXEC"
  fetch_seconds="$("$JQ_EXEC" -r '.fetch_timeout_seconds' "$POLICY")"
  if [[ ! -d "$mirror" ]]; then
    trusted_git init --bare "$mirror" >/dev/null 2>&1 || return 11
    trusted_git --git-dir="$mirror" remote add origin "$TRUST_REMOTE" >/dev/null 2>&1 || return 11
  fi
  trusted_git --git-dir="$mirror" rev-parse --is-bare-repository 2>/dev/null | grep -qx true || return 11
  mirror_config_is_exact || return 12
  # Inspect the stored value, not `remote get-url`, which expands `insteadOf`
  # rules before returning it and can make an exact stored anchor look changed.
  url="$(trusted_git --git-dir="$mirror" config --get remote.origin.url 2>/dev/null || true)"
  if [[ "$url" == "$LEGACY_TRUST_REMOTE" ]]; then
    trusted_git --git-dir="$mirror" config remote.origin.url "$TRUST_REMOTE" >/dev/null 2>&1 || return 12
    url="$(trusted_git --git-dir="$mirror" config --get remote.origin.url 2>/dev/null || true)"
  fi
  [[ "$url" == "$TRUST_REMOTE" ]] || return 12
  shallow="$(trusted_git --git-dir="$mirror" rev-parse --is-shallow-repository 2>/dev/null || true)"
  [[ "$shallow" == false ]] || return 13
  ssh_option_path_is_safe "$DEPLOY_KEY" && ssh_option_path_is_safe "$PINNED_KNOWN_HOSTS" || return 22
  deploy_key_is_usable || return 18
  [[ -n "$SSH_EXEC" && ! -L "$PINNED_KNOWN_HOSTS" && -f "$PINNED_KNOWN_HOSTS" &&
     -s "$PINNED_KNOWN_HOSTS" ]] || return 19
  # stderr goes to a private scratch file that the EXIT trap also removes.
  fetch_error="$release_root/.child-output.fetch.${ATTEMPT_ID:-$$}"
  (umask 077; : >"$fetch_error") || return 14
  ACTIVE_OUTPUT_FILE="$fetch_error"
  run_tracked "$bound" "$fetch_seconds" "${GIT_ENV_COMMAND[@]}" \
    GIT_SSH_COMMAND="$(release_ssh_command)" \
    "$GIT_EXEC" -c http.sslVerify=true --git-dir="$mirror" \
    fetch --no-tags --no-recurse-submodules origin \
    "+$TRUST_REF:refs/afk/fetched" >/dev/null 2>"$fetch_error"
  fetch_rc=$?
  fetch_stderr="$(file_contents_or_empty "$fetch_error")"
  rm -f -- "$fetch_error"
  ACTIVE_OUTPUT_FILE=""
  if (( fetch_rc != 0 )); then
    classify_fetch_failure "$fetch_stderr"
    return
  fi
  TARGET_REVISION="$(trusted_git --git-dir="$mirror" rev-parse 'refs/afk/fetched^{commit}' 2>/dev/null || true)"
  validate_commit "$TARGET_REVISION" || return 15
  if [[ -n "$PRIOR_REVISION" ]]; then
    trusted_git --git-dir="$mirror" cat-file -e "$PRIOR_REVISION^{commit}" 2>/dev/null || return 16
    trusted_git --git-dir="$mirror" merge-base --is-ancestor "$PRIOR_REVISION" "$TARGET_REVISION" 2>/dev/null || return 17
  fi
  return 0
}

candidate_is_clean() {
  local path="$1" head branch
  [[ -d "$path/.git" ]] || return 1
  head="$(trusted_git -C "$path" rev-parse HEAD 2>/dev/null || true)"; branch="$(trusted_git -C "$path" symbolic-ref --short HEAD 2>/dev/null || true)"
  [[ "$head" == "$TARGET_REVISION" && "$branch" == "$TRUST_BRANCH" ]] || return 1
  # Qualification executes tests, so cleanliness must cover the whole
  # candidate, including untracked files outside managed_inputs.
  [[ -z "$(trusted_git -C "$path" status --porcelain=v1 --untracked-files=all)" ]]
}

candidate_identity() {
  "$STAT_EXEC" -c '%d:%i' "$1" 2>/dev/null
}

candidate_is_current_trusted() {
  local path="$1" canonical
  sha_ok "$TARGET_REVISION" || return 1
  [[ "$path" == "$candidate_root/$TARGET_REVISION" && -d "$path" && ! -L "$path" ]] || return 1
  canonical="$("$REALPATH_EXEC" -e -- "$path" 2>/dev/null)" || return 1
  [[ "$canonical" == "$path" && -f "$path/bin/agent-flow-kit" &&
     -x "$path/bin/agent-flow-kit" && ! -L "$path/bin/agent-flow-kit" ]] || return 1
  [[ -z "$QUALIFIED_CANDIDATE_ID" || "$(candidate_identity "$path")" == "$QUALIFIED_CANDIDATE_ID" ]] || return 1
  candidate_is_clean "$path"
}

# Deliberate no-op boundary: copied-client fixtures replace this to simulate a
# candidate swap at the last instant without PATH shadowing production tools.
candidate_pre_use_boundary() { :; }

materialize_candidate() {
  local destination="$candidate_root/$TARGET_REVISION" stage quarantined
  if [[ -e "$destination" ]] && candidate_is_clean "$destination"; then printf '%s\n' "$destination"; return 0; fi
  if [[ -e "$destination" ]]; then
    quarantined="$candidate_root/quarantine.$TARGET_REVISION.$LOCK_INCARNATION"
    mv -- "$destination" "$quarantined" || return 1
  fi
  stage="$candidate_root/.stage.$TARGET_REVISION.$LOCK_INCARNATION"
  trusted_git init -q -b afk-stage "$stage" >/dev/null 2>&1 || return 1
  trusted_git -C "$stage" remote add origin "$mirror" >/dev/null 2>&1 || return 1
  trusted_git -C "$stage" fetch --no-tags --no-recurse-submodules origin \
    'refs/afk/fetched:refs/afk/candidate' >/dev/null 2>&1 || return 1
  trusted_git -C "$stage" checkout -b "$TRUST_BRANCH" refs/afk/candidate >/dev/null 2>&1 || return 1
  candidate_is_clean "$stage" || return 1
  mv -- "$stage" "$destination" || return 1
  printf '%s\n' "$destination"
}

qualify_candidate_behavior() {
  local path="$1" bound="$2" seconds="$3" state freshness memory
  QUALIFICATION_DIR="$(mktemp -d "$release_root/.qualification.XXXXXX")" || return 1
  state="$QUALIFICATION_DIR/state"
  mkdir -p "$state/releases" || { qualification_dir_remove; return 1; }
  "$JQ_EXEC" -nc --arg revision "$TARGET_REVISION" \
    '{schema_version:"1.0",applied_revision:$revision}' >"$state/state.json" \
    || { qualification_dir_remove; return 1; }
  "$JQ_EXEC" -nc --arg revision "$TARGET_REVISION" \
    '{schema:"afk-release-current/1",revision:$revision}' >"$state/releases/current.json" \
    || { qualification_dir_remove; return 1; }

  candidate_sandbox_command "$path" "$state" "$bound" "$seconds" \
    /bin/bash /candidate/bin/afk-session-freshness 2>/dev/null || true
  freshness="$CAPTURED_OUTPUT"
  if ! "$JQ_EXEC" -e --arg revision "$TARGET_REVISION" '
      .schema=="afk-session-freshness/2" and .state=="ACCEPTED_LOCALLY" and
      .reason=="RECORDED_LAST_GOOD" and .applied_revision==$revision and
      .accepted_revision==$revision and .offline==true and .launch_authoritative==false
    ' <<<"$freshness" >/dev/null 2>&1; then
    qualification_dir_remove
    return 1
  fi
  candidate_sandbox_command "$path" "$state" "$bound" "$seconds" \
    /bin/bash -p /candidate/adapters/hindsight.sh blind /candidate 2>/dev/null || true
  memory="$CAPTURED_OUTPUT"
  if ! "$JQ_EXEC" -e '
      .schema=="afk-memory-context/2" and .state=="DISABLED" and
      .native_integration=="BYPASSED_BY_SUPPORTED_CONFIG" and
      .environment.HINDSIGHT_DISABLED=="true" and .recall==[] and .retain==[]
    ' <<<"$memory" >/dev/null 2>&1; then
    qualification_dir_remove
    return 1
  fi
  qualification_dir_remove
}

qualify_candidate() {
  local path="$1" bound seconds script
  [[ -x "$path/bin/agent-flow-kit" && -r "$path/tests/release-update-tests.sh" ]] || return 1
  bound="$TIMEOUT_EXEC"
  seconds="$("$JQ_EXEC" -r '.qualification_timeout_seconds' "$POLICY")"
  resolve_candidate_sandbox || return 2
  candidate_sandbox_command "$path" "$release_root" "$bound" "$seconds" /bin/true \
    >/dev/null 2>&1 || return 2
  # Parse the distributed executables and validate their release policy before
  # executing the bounded, offline runtime smoke below.
  for script in bin/agent-flow-kit bin/afk-release-reconcile \
      bin/afk-session-freshness bin/afk-session-start tests/release-update-tests.sh; do
    "$bound" "$seconds" env -i PATH=/usr/bin:/bin LANG=C \
      /bin/bash -p -n "$path/$script" >/dev/null 2>&1 || return 1
  done
  # shellcheck disable=SC2016 # jq variables, not shell interpolation
  "$bound" "$seconds" env -i PATH=/usr/bin:/bin LANG=C "$JQ_EXEC" -e \
    --arg remote "$TRUST_REMOTE" --arg ref "$TRUST_REF" \
    --arg branch "$TRUST_BRANCH" --arg root "$TRUST_ROOT" '
      .schema=="afk-release-policy/2" and .trust.remote_url==$remote and
      .trust.ref==$ref and .trust.default_branch==$branch and
      .trust.repository_root_commit==$root and
      (.fetch_timeout_seconds|type=="number" and .>=1 and .<=300) and
      (.qualification_timeout_seconds|type=="number" and .>=1 and .<=600) and
      (.check_interval_seconds|type=="number" and .>=0 and .<=86400) and
      .offline_fallback=="RETAIN_PROVEN_LAST_GOOD" and
      .rollout.mode=="cohort_metadata_only" and .rollout.authoritative_promotion==false and
      .automatic_rollback_bypass==false
    ' "$path/lifecycle/release-policy.json" >/dev/null 2>&1 || return 1
  qualify_candidate_behavior "$path" "$bound" "$seconds" || return 1
  candidate_sandbox_command "$path" "$release_root" "$bound" "$seconds" \
    /bin/bash -p /candidate/tests/release-update-tests.sh --candidate-smoke /candidate \
    >/dev/null 2>&1 || return 1
  candidate_is_clean "$path" || return 1
  QUALIFIED_CANDIDATE_ID="$(candidate_identity "$path")"
  [[ -n "$QUALIFIED_CANDIDATE_ID" ]]
}

trusted_lifecycle_capture() {
  local path="$1"
  shift
  CAPTURED_OUTPUT=""
  candidate_pre_use_boundary "$path"
  candidate_is_current_trusted "$path" || return 125
  [[ -x "$TRUSTED_DRIVER_DIR/bin/agent-flow-kit" &&
     -d "$TRUSTED_DRIVER_DIR/lib" ]] || return 125
  run_tracked_capture env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C \
    AFK_LIB_DIR="$TRUSTED_DRIVER_DIR/lib" AFK_KIT_ROOT="$path" AFK_STATE_DIR="$STATE_DIR" \
    AFK_MANIFEST="$STATE_DIR/state.json" AFK_JOURNAL="$STATE_DIR/journal.json" \
    AFK_LOCK_DIR="$STATE_DIR/lock" AFK_BACKUP_ROOT="$STATE_DIR/backups" \
    AFK_STAGE_ROOT="$STATE_DIR/stage" AFK_SKILLS_HOME="$DERIVED_SKILLS_HOME" \
    AFK_CLAUDE_HOME="$DERIVED_CLAUDE_HOME" AFK_CODEX_HOME="$DERIVED_CODEX_HOME" \
    AFK_ORCH_STATE="$STATE_DIR/orchestration.json" AFK_DISPATCH_DIR="$STATE_DIR/dispatch" \
    AFK_DISPATCH_WATCH_DIR="$STATE_DIR/dispatch/watch" \
    AFK_DISPATCH_INBOX_DIR="$STATE_DIR/dispatch/inbox" \
    AFK_DISPATCH_RESULT_DIR="$STATE_DIR/dispatch/results" \
    AFK_DISPATCH_MESSAGE_DIR="$STATE_DIR/dispatch/messages" \
    AFK_PM_DIR="$STATE_DIR/pm/release-reconcile" \
    "$TRUSTED_DRIVER_DIR/bin/agent-flow-kit" "$@"
}

prove_last_good() {
  local revision path manifest verified
  [[ -r "$current_file" ]] || return 1
  revision="$("$JQ_EXEC" -r '.revision // ""' "$current_file" 2>/dev/null)"
  path="$("$JQ_EXEC" -r '.candidate_path // ""' "$current_file" 2>/dev/null)"
  sha_ok "$revision" || return 1
  [[ "$path" == "$candidate_root/$revision" ]] || return 1
  TARGET_REVISION="$revision"
  QUALIFIED_CANDIDATE_ID=""
  candidate_is_clean "$path" || return 1
  QUALIFIED_CANDIDATE_ID="$(candidate_identity "$path")"
  [[ -n "$QUALIFIED_CANDIDATE_ID" ]] || return 1
  manifest="$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null)"
  [[ "$manifest" == "$revision" ]] || return 1
  trusted_lifecycle_capture "$path" verify --json 2>/dev/null || true
  verified="$CAPTURED_OUTPUT"
  "$JQ_EXEC" -e '.kind=="lifecycle_result" and .overall.exit_code==0 and .extra.verification.verified==true' <<<"$verified" >/dev/null 2>&1 || return 1
  LAST_GOOD=true; LAST_GOOD_VERIFIED=true; APPLIED_REVISION="$revision"
  return 0
}

retain_last_good_or_block() { # <reason> [blocked-exit]
  local reason="$1" blocked_exit="${2:-2}"
  if [[ "$MODE" == apply ]] && prove_last_good; then
    finish RETAINED "$reason" 0
  fi
  finish BLOCKED "$reason" "$blocked_exit"
}

validate_plan() {
  local document="$1" disposition target prior approvals conflicts refusal
  "$JQ_EXEC" -e '.kind=="lifecycle_result" and .source_eligibility.state=="ELIGIBLE" and .source_eligibility.mutation_allowed==true' <<<"$document" >/dev/null 2>&1 || return 1
  disposition="$("$JQ_EXEC" -r '.extra.plan.disposition // ""' <<<"$document")"
  [[ "$disposition" == NO_CHANGE || "$disposition" == MUTATION_REQUIRED ]] || return 1
  target="$("$JQ_EXEC" -r '.extra.plan.target_revision // ""' <<<"$document")"
  prior="$("$JQ_EXEC" -r '.extra.plan.prior_revision // ""' <<<"$document")"
  approvals="$("$JQ_EXEC" -r '.extra.plan.approvals_required // -1' <<<"$document")"
  conflicts="$("$JQ_EXEC" -r '.extra.plan.conflicts // -1' <<<"$document")"
  refusal="$("$JQ_EXEC" -r '.extra.plan.refusal_reason // ""' <<<"$document")"
  [[ "$target" == "$TARGET_REVISION" && "$prior" == "$PRIOR_REVISION" && "$approvals" == 0 && "$conflicts" == 0 && -z "$refusal" ]] || return 1
  PLAN_IDENTITY="$("$JQ_EXEC" -r '.extra.plan.plan_identity // ""' <<<"$document")"
  [[ "$PLAN_IDENTITY" =~ ^sha256:[0-9a-f]{64}$ ]]
}

# The lifecycle names an operation only once it takes its lock, so a no-change
# result and every refusal decided before the lock carry `operation.id: null`.
# reason_is_published <code> — true only for a code the trusted driver
# publishes: a line inside the heredoc body of afk_reason_codes (afk-common.sh)
# or afk_mutation_reason_codes (afk-mutate.sh). The heredoc delimiter and every
# other line of those files are not codes. Pure bash, so no untrusted tool
# reads the vocabulary.
reason_is_published() {
  local code="$1" file line where
  [[ "$code" =~ ^[A-Z][A-Z0-9_]{1,63}$ ]] || return 1
  for file in "$TRUSTED_DRIVER_DIR/lib/afk-common.sh" "$TRUSTED_DRIVER_DIR/lib/afk-mutate.sh"; do
    [[ -f "$file" && -r "$file" ]] || continue
    where=outside
    while IFS= read -r line; do
      case "$where:$line" in
        "outside:afk_reason_codes() {"|"outside:afk_mutation_reason_codes() {") where=function ;;
        "function:  cat <<'CODES'") where=body ;;
        function:*) where=outside ;;
        body:CODES) where=outside ;;
        body:*) [[ "$line" == "$code" ]] && return 0 ;;
      esac
    done <"$file"
  done
  return 1
}

# A convergence, a rollback or any other result that wrote must name its
# operation. The lifecycle's own reason is kept only when it is a code of the
# trusted driver's published reason vocabulary, so a candidate cannot put
# arbitrary text in the record.
validate_operation() {
  local document="$1" id result reason
  "$JQ_EXEC" -e '.kind=="lifecycle_result" and (.operation|type)=="object" and
    ((.operation.id|type)=="string" or
     (.operation.id==null and (.operation.result as $r | ["NO_CHANGE","REFUSED","APPROVAL_REQUIRED"] | index($r)) != null)) and
    (.operation.result|type)=="string" and
    (.operation.result as $result |
      (["NO_CHANGE","CONVERGED","ADOPTED","PLAN_ONLY","APPROVAL_REQUIRED","REFUSED",
        "STALE_PLAN","ROLLED_BACK","UNRECOVERABLE","RECOVERED"] | index($result)) != null)' \
    <<<"$document" >/dev/null 2>&1 || return 1
  id="$("$JQ_EXEC" -r '.operation.id // ""' <<<"$document")"
  result="$("$JQ_EXEC" -r '.operation.result' <<<"$document")"
  reason="$("$JQ_EXEC" -r '.operation.reason | strings' <<<"$document" 2>/dev/null)"
  [[ -z "$id" || "$id" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]] || return 1
  if reason_is_published "$reason"; then OPERATION_REASON="$reason"; fi
  OPERATION_ID="$id"
  OPERATION_RESULT="$result"
}

[[ "$COHORT" == canary || "$COHORT" == wave ]] || { usage >&2; exit 2; }
case "${OSTYPE:-}" in
  linux*) : ;;
  darwin*)
    printf '%s\n' '{"schema":"afk-release-result/2","state":"BLOCKED","reason":"MACOS_SANDBOX_PENDING"}'
    exit 2
    ;;
  *)
    printf '%s\n' '{"schema":"afk-release-result/2","state":"BLOCKED","reason":"AUTO_UPDATE_PLATFORM_UNSUPPORTED"}'
    exit 2
    ;;
esac
validate_release_tools || {
  printf '%s\n' '{"schema":"afk-release-result/2","state":"BLOCKED","reason":"REQUIRED_TOOL_UNTRUSTED"}'
  exit 2
}
STARTED_AT="$("$DATE_EXEC" -u +%Y-%m-%dT%H:%M:%SZ)"
prepare_git_environment
validate_policy || { printf '%s\n' '{"schema":"afk-release-result/2","state":"BLOCKED","reason":"POLICY_UNTRUSTED"}'; exit 2; }
prepare_state || { printf '%s\n' '{"schema":"afk-release-result/2","state":"BLOCKED","reason":"STATE_DIRECTORY_UNSAFE"}'; exit 2; }
ATTEMPT_ID="$("$DATE_EXEC" -u +%Y%m%dT%H%M%SZ).$$.$(new_incarnation)"
acquire_lock
lock_rc=$?
case "$lock_rc" in
  0) : ;;
  1) finish BLOCKED LOCK_INITIALIZATION_FAILED 2 false ;;
  *) finish RETAINED CONCURRENT_OPERATION_IN_PROGRESS 0 false ;;
esac

read_applied; PRIOR_REVISION="$APPLIED_REVISION"
[[ -n "$PRIOR_REVISION" ]] || finish BLOCKED INSTALLATION_NOT_ADOPTED 2
derive_candidate_destinations || finish BLOCKED INSTALLED_DESTINATIONS_UNTRUSTED 2
prepare_trusted_driver || finish BLOCKED TRUSTED_DRIVER_UNAVAILABLE 2

# Frequent SessionStart events prove the accepted local release but avoid a
# network call until the declared interval expires. `--force-check` bypasses
# this path for operators and scheduled reconciliation.
if [[ "$MODE" == apply && "$FORCE" != true && -r "$current_file" ]]; then
  checked="$("$JQ_EXEC" -r '.checked_at_epoch // 0' "$current_file" 2>/dev/null)"
  interval="$("$JQ_EXEC" -r '.check_interval_seconds' "$POLICY")"
  if [[ "$checked" =~ ^[0-9]+$ && "$interval" =~ ^[0-9]+$ ]] \
    && (( $(now_epoch) - checked >= 0 && $(now_epoch) - checked < interval )) \
    && prove_last_good; then
    finish CURRENT CHECK_INTERVAL_NOT_ELAPSED 0
  fi
fi

fetch_candidate_revision
fetch_rc=$?
if [[ $fetch_rc -ne 0 ]]; then
  case "$fetch_rc" in
    10) retain_last_good_or_block REQUIRED_BOUND_UNAVAILABLE ;;
    11) retain_last_good_or_block RELEASE_MIRROR_UNUSABLE ;;
    17) retain_last_good_or_block SOURCE_NOT_FORWARD_ANCESTOR ;;
    15|16) retain_last_good_or_block FETCHED_HISTORY_UNTRUSTED ;;
    12|13) retain_last_good_or_block RELEASE_MIRROR_UNTRUSTED ;;
    18) retain_last_good_or_block DEPLOY_KEY_UNAVAILABLE ;;
    19) retain_last_good_or_block RELEASE_TRANSPORT_UNAVAILABLE ;;
    20) retain_last_good_or_block HOST_KEY_MISMATCH ;;
    21) retain_last_good_or_block DEPLOY_KEY_REJECTED ;;
    22) retain_last_good_or_block SSH_OPTION_PATH_UNSAFE ;;
    23) retain_last_good_or_block REPOSITORY_ACCESS_DENIED ;;
    14)
      if prove_last_good; then finish RETAINED FETCH_UNAVAILABLE 0; fi
      finish BLOCKED FETCH_UNAVAILABLE_NO_PROVEN_LAST_GOOD 2
      ;;
    *) retain_last_good_or_block FETCH_FAILED_UNCLASSIFIED ;;
  esac
fi

candidate="$(materialize_candidate)" || retain_last_good_or_block CANDIDATE_CHECKOUT_FAILED
qualify_candidate "$candidate"
qualification_rc=$?
case "$qualification_rc" in
  0) : ;;
  2) retain_last_good_or_block CANDIDATE_SANDBOX_UNAVAILABLE ;;
  *) retain_last_good_or_block CANDIDATE_QUALIFICATION_FAILED ;;
esac

trusted_lifecycle_capture "$candidate" update --json --plan 2>/dev/null || true
plan_doc="$CAPTURED_OUTPUT"
validate_plan "$plan_doc" || retain_last_good_or_block PLAN_NOT_SAFE_TO_APPLY
disposition="$("$JQ_EXEC" -r '.extra.plan.disposition' <<<"$plan_doc")"
if [[ "$MODE" == plan ]]; then
  [[ "$disposition" == NO_CHANGE ]] && finish CURRENT PLAN_VERIFIED_NO_CHANGE 0
  finish PLANNED PLAN_VERIFIED 0
fi

trusted_lifecycle_capture "$candidate" update --json --approve-plan "$PLAN_IDENTITY" 2>/dev/null || true
apply_doc="$CAPTURED_OUTPUT"
validate_operation "$apply_doc" || finish BLOCKED APPLY_RESULT_UNREADABLE 2
case "$OPERATION_RESULT" in
  CONVERGED|NO_CHANGE)
    trusted_lifecycle_capture "$candidate" verify --json 2>/dev/null || true
    verify_doc="$CAPTURED_OUTPUT"
    if ! "$JQ_EXEC" -e --arg revision "$TARGET_REVISION" '.kind=="lifecycle_result" and .overall.exit_code==0 and .extra.verification.verified==true and .installed.applied_revision==$revision' <<<"$verify_doc" >/dev/null 2>&1; then
      [[ "$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null)" == "$PRIOR_REVISION" ]] && { LAST_GOOD=true; LAST_GOOD_VERIFIED=false; }
      finish BLOCKED POST_APPLY_VERIFY_FAILED 2
    fi
    current_doc="$("$JQ_EXEC" -nc --arg revision "$TARGET_REVISION" --arg path "$candidate" --arg accepted "$("$DATE_EXEC" -u +%Y-%m-%dT%H:%M:%SZ)" --argjson checked "$(now_epoch)" '{schema:"afk-release-current/1",revision:$revision,candidate_path:$path,accepted_at:$accepted,checked_at_epoch:$checked}')"
    atomic_json_write "$current_file" "$current_doc" || finish BLOCKED ACCEPTED_STATE_WRITE_FAILED 2
    LAST_GOOD=true; LAST_GOOD_VERIFIED=true
    [[ "$OPERATION_RESULT" == NO_CHANGE ]] && finish CURRENT ALREADY_CURRENT 0
    finish CONVERGED RELEASE_APPLIED 0
    ;;
  ROLLED_BACK)
    [[ "$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null)" == "$PRIOR_REVISION" ]] && LAST_GOOD=true
    finish ROLLED_BACK APPLY_ROLLED_BACK 2
    ;;
  UNRECOVERABLE)
    finish BLOCKED APPLY_UNRECOVERABLE 2
    ;;
  REFUSED)
    [[ "$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null)" == "$PRIOR_REVISION" ]] && LAST_GOOD=true
    finish RETAINED APPLY_REFUSED 2
    ;;
  STALE_PLAN)
    [[ "$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null)" == "$PRIOR_REVISION" ]] && LAST_GOOD=true
    finish RETAINED APPLY_STALE_PLAN 2
    ;;
  APPROVAL_REQUIRED)
    [[ "$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null)" == "$PRIOR_REVISION" ]] && LAST_GOOD=true
    finish RETAINED APPLY_APPROVAL_REQUIRED 2
    ;;
  RECOVERED)
    [[ "$("$JQ_EXEC" -r '.applied_revision // ""' "$STATE_DIR/state.json" 2>/dev/null)" == "$PRIOR_REVISION" ]] && LAST_GOOD=true
    finish RETAINED APPLY_RECOVERED 2
    ;;
  *) finish BLOCKED APPLY_RESULT_UNREADABLE 2 ;;
esac
