=== the source lines this attack transcribes ===
1540:  if [[ -z "$RESULT_STATUS" && "$GATES_OK" != true \
1541-        && "$BUDGET_STATE" == "CONTINUATION_REQUIRED" ]]; then
1542-    RESULT_STATUS="continuation_required"
1543-    log "budget: usage reached the continuation band with gates failed and no worker signal"
1544-  fi
1545:  [[ -n "$RESULT_STATUS" ]] || \
1546-    RESULT_STATUS="$([[ $GATES_OK == true ]] && echo 'done' || echo 'gates_failed')"
1610:  [[ "$GATES_OK" == true && "$RESULT_STATUS" == "done" ]] \
1611-    && exit "$EX_DONE" || exit "$EX_GATES_FAILED"
1612-}

=== the matrix ===
signal=no  gates=true  budget.state=OK                     -> status=done                   exit=0
signal=no  gates=true  budget.state=CHECKPOINT_DUE         -> status=done                   exit=0
signal=no  gates=true  budget.state=CONTINUATION_REQUIRED  -> status=done                   exit=0
signal=no  gates=true  budget.state=NOT_EVALUATED          -> status=done                   exit=0
signal=no  gates=false budget.state=OK                     -> status=gates_failed           exit=1
signal=no  gates=false budget.state=CHECKPOINT_DUE         -> status=gates_failed           exit=1
signal=no  gates=false budget.state=CONTINUATION_REQUIRED  -> status=continuation_required  exit=1
signal=no  gates=false budget.state=NOT_EVALUATED          -> status=gates_failed           exit=1
signal=yes gates=true  budget.state=OK                     -> status=continuation_required  exit=1
signal=yes gates=true  budget.state=CHECKPOINT_DUE         -> status=continuation_required  exit=1
signal=yes gates=true  budget.state=CONTINUATION_REQUIRED  -> status=continuation_required  exit=1
signal=yes gates=true  budget.state=NOT_EVALUATED          -> status=continuation_required  exit=1
signal=yes gates=false budget.state=OK                     -> status=continuation_required  exit=1
signal=yes gates=false budget.state=CHECKPOINT_DUE         -> status=continuation_required  exit=1
signal=yes gates=false budget.state=CONTINUATION_REQUIRED  -> status=continuation_required  exit=1
signal=yes gates=false budget.state=NOT_EVALUATED          -> status=continuation_required  exit=1

=== the row to look at ===
signal=no gates=true budget.state=CONTINUATION_REQUIRED  ->  status=done, exit 0
  i.e. an END-OF-RUN usage at or past continuation_ratio on a run whose gates
  passed publishes budget.state=CONTINUATION_REQUIRED beside status=done, and
  the monitor projects context_budget=CONTINUATION_REQUIRED on a COMPLETED,
  settled Dispatch. Nothing in the contract's table covers this combination.

=== reachability: the usage that produces it ===
a run that ended at 180000/200000 with passing gates: budget.state=CONTINUATION_REQUIRED findings=[HIGH_USAGE]
